{
  "name": "opencode-webbridge",
  "version": "0.0.0",
  "private": true,
  "description": "Experimental native OpenCode 2 plugin scaffold for browser-backed web chat providers",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node scripts/run-tests.mjs",
    "check:backlog": "node scripts/check-backlog.mjs",
    "check:progress": "node scripts/check-progress.mjs",
    "smoke:native": "npm run build && node scripts/smoke-native-provider.mjs",
    "smoke:browser": "npm run build && node scripts/smoke-native-provider.mjs --browser-fixture",
    "smoke:rpc": "npm run build && node scripts/smoke-rpc-relay.mjs",
    "smoke:e2e": "npm run build && node scripts/smoke-model-rpc-e2e.mjs",
    "smoke:page": "npm run build && node scripts/smoke-model-rpc-e2e.mjs --real-page",
    "journal:operator": "npm run build && node scripts/reconcile-relay.mjs",
    "issues:dry-run": "node scripts/sync-github-issues.mjs",
    "issues:sync": "node scripts/sync-github-issues.mjs --apply"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.29"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "1.64.1",
    "typescript": "^5.9.3"
  }
}
