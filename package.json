{
  "name": "opencode-webbridge",
  "version": "0.0.0",
  "private": true,
  "description": "Experimental native OpenCode 2 plugin scaffold for browser-backed web chat providers",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./index.mjs",
  "bin": {
    "webbridge-manual-chatgpt": "./bin/webbridge-manual-chatgpt.mjs",
    "webbridge-manual-observe": "./bin/webbridge-manual-observe.mjs",
    "webbridge-journal": "./bin/webbridge-journal.mjs"
  },
  "types": "./dist/src/index.d.ts",
  "files": ["index.mjs", "bin/", "dist/src/", "README.md", "LICENSE", "SECURITY.md", "THIRD-PARTY-NOTICES.md"],
  "scripts": {
    "prepack": "node scripts/g164-prepare-package.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node scripts/run-tests.mjs",
    "check:backlog": "node scripts/check-backlog.mjs",
    "check:progress": "node scripts/check-progress.mjs",
    "check:policy": "node scripts/check-provider-policy.mjs",
    "check:compat": "node scripts/check-compatibility.mjs",
    "check:acceptance": "node scripts/check-acceptance.mjs",
    "check:sbom": "node scripts/check-sbom.mjs",
    "check:release": "node scripts/check-release.mjs",
    "diagnose:install": "node scripts/diagnose-install.mjs",
    "check:g119": "node scripts/check-g119-cross-stream.mjs",
    "check:d01d02": "node scripts/probe-d01d02-desktop-public-api.mjs",
    "check:plugin-browser": "node scripts/probe-plugin-browser-capability.mjs",
    "preview:package": "node scripts/offline-package-preview.mjs",
    "preview:rpc-package": "node scripts/offline-rpc-package.mjs",
    "smoke:rpc-package-native": "node scripts/offline-rpc-package.mjs --native",
    "smoke:packaged-model": "npm run build && node scripts/smoke-packaged-model.mjs",
    "preview:g97": "node scripts/smoke-combined-package.mjs",
    "smoke:g97-native": "npm run build && node scripts/smoke-combined-package.mjs --native",
    "smoke:g125-native": "npm run build && node scripts/smoke-g125-v2032.mjs",
    "smoke:g130-native": "npm run build && node scripts/smoke-g130-v2032.mjs",
    "smoke:g149-vertical": "npm run build && node scripts/smoke-g149-vertical.mjs",
    "smoke:actual-package": "npm run build && node scripts/smoke-distributed-entrypoint.mjs",
    "smoke:actual-package-native": "npm run build && node scripts/smoke-distributed-entrypoint.mjs --native",
    "smoke:g152-root-vertical": "npm run build && node scripts/smoke-g152-real-root.mjs",
    "smoke:g153-root-git": "npm run build && node scripts/smoke-g153-root-git.mjs",
    "smoke:g99-page": "npm run build && node scripts/smoke-combined-page.mjs",
    "smoke:package-native": "node scripts/offline-package-preview.mjs --native",
    "smoke:native": "npm run build && node scripts/smoke-native-provider.mjs",
    "smoke:browser": "npm run build && node scripts/smoke-native-provider.mjs --browser-fixture",
    "smoke:rpc": "npm run build && node scripts/smoke-rpc-relay.mjs",
    "smoke:e2e": "npm run build && node scripts/smoke-model-rpc-e2e.mjs",
    "smoke:page": "npm run build && node scripts/smoke-model-rpc-e2e.mjs --real-page",
    "smoke:local-read": "npm run build && node scripts/smoke-local-read-page.mjs",
    "smoke:dom-rpc": "npm run build && node scripts/smoke-dom-rpc-progress.mjs",
    "journal:operator": "npm run build && node scripts/reconcile-relay.mjs",
    "issues:dry-run": "node scripts/sync-github-issues.mjs",
    "issues:sync": "node scripts/sync-github-issues.mjs --apply",
    "docs:traceability": "node scripts/generate-traceability.mjs --write",
    "docs:qualification": "node scripts/generate-qualification.mjs --write"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.29",
    "effect": "4.0.1",
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
