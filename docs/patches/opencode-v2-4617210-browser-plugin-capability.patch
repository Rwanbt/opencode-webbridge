@@ -0,0 +1,123 @@
+import { expect, test } from "bun:test"
+import { desktopReadCommitGate, startCommittedRead } from "./read-commit-gate"
+import { Browser } from "@opencode/plugin-browser/rpc"
+
+test("direct IPC snapshot without native host read commit is denied before any effect", () => {
+  let effects = 0
+  const dispatch = (type: string, ticket?: unknown) => {
+    if (!desktopReadCommitGate(type, ticket)) return false
+    effects++
+    return true
+  }
+  for (const forged of [undefined, null, "", false, 0]) {
+    expect(dispatch("snapshot", forged)).toBe(false)
+  }
+  expect(effects).toBe(0)
+  expect(dispatch("snapshot", "one-use-host-ticket")).toBe(true)
+  expect(effects).toBe(1)
+})
+
+test("a snapshot ticket never upgrades another desktop command", () => {
+  for (const action of ["navigate", "click", "fill", "submit", "tabs.list"]) {
+    expect(desktopReadCommitGate(action, "borrowed-read-ticket")).toBe(false)
+  }
+  expect(desktopReadCommitGate("tabs.list", undefined)).toBe(false)
+})
+
+test("direct IPC cannot bypass Core read authority through other page-content operations", () => {
+  for (const action of ["tabs.list", "frames", "find", "evaluate", "screenshot", "wait", "dialog",
+    "network.list", "network.get", "console", "files.list", "files.get", "trace.stop", "cpu.stop",
+    "heap.snapshot", "heap.object", "lighthouse", "arbitrary-future-read"]) {
+    expect(desktopReadCommitGate(action, undefined)).toBe(false)
+    expect(desktopReadCommitGate(action, "stolen-snapshot-token")).toBe(false)
+  }
+  // Keep host and Core connection policies in lockstep as operations evolve.
+  for (const operation of Browser.Operations) {
+    if (operation.name === "snapshot") continue
+    expect(desktopReadCommitGate(operation.name, undefined)).toBe(Browser.legacyActionAllowed(operation.name))
+  }
+})
+
+test("revoking the Desktop tab while page.ready is pending prevents browser execution", async () => {
+  let release!: () => void
+  const ready = new Promise<void>((resolve) => { release = resolve })
+  let live = true
+  let effects = 0
+  const reading = startCommittedRead(ready, () => live, async () => {
+    effects++
+    return "untrusted page content"
+  }, async () => true)
+  live = false // Cancellation, navigation or tab generation replacement during readiness.
+  release()
+  await expect(reading).rejects.toThrow(/revoked/)
+  expect(effects).toBe(0)
+})
+
+test("a live committed read begins its driver once after readiness", async () => {
+  let effects = 0
+  const result = await startCommittedRead(Promise.resolve(), () => true, async () => {
+    effects++
+    return "offline fixture snapshot"
+  }, async () => true)
+  expect(result).toBe("offline fixture snapshot")
+  expect(effects).toBe(1)
+})
+
+test("revocation during the pending Chromium read cannot expose returned page content", async () => {
+  let finish!: (value: string) => void
+  const pending = new Promise<string>((resolve) => { finish = resolve })
+  let live = true
+  let started = 0
+  let signalStart!: () => void
+  const dispatched = new Promise<void>((resolve) => { signalStart = resolve })
+  const read = startCommittedRead(Promise.resolve(), () => live, () => {
+    started++
+    signalStart()
+    return pending
+  }, async () => true)
+  await dispatched // No assumptions about Core RPC microtask scheduling.
+  expect(started).toBe(1)
+  live = false // Tab replaced/disconnected AFTER driver invocation, BEFORE result.
+  finish("private page content must never be delivered")
+  await expect(read).rejects.toThrow(/revoked/)
+})
+
+test("Core revocation after commit during page.ready denies Chromium effect", async () => {
+  let ready!: () => void
+  const pending = new Promise<void>((resolve) => { ready = resolve })
+  let coreAuthorized = true
+  let effects = 0
+  const reading = startCommittedRead(pending, () => true, async () => {
+    effects++
+    return "secret page text"
+  }, async () => coreAuthorized)
+  coreAuthorized = false
+  ready()
+  await expect(reading).rejects.toThrow(/Core read lease revoked/)
+  expect(effects).toBe(0)
+})
+
+test("Desktop replacement while Core read.live awaits blocks the pending effect", async () => {
+  let finish!: (allow: boolean) => void
+  const core = new Promise<boolean>((resolve) => { finish = resolve })
+  let attached = true
+  let effects = 0
+  const reading = startCommittedRead(Promise.resolve(), () => attached, async () => {
+    effects++
+    return "secret page text"
+  }, () => core)
+  await Promise.resolve()
+  attached = false
+  finish(true)
+  await expect(reading).rejects.toThrow(/revoked/)
+  expect(effects).toBe(0)
+})
+
+test("direct renderer actions are never a page-content read authority", () => {
+  for (const action of ["snapshot", "frames", "evaluate", "screenshot", "network.get", "tabs.list", "new.read"]) {
+    expect(desktopReadCommitGate(action, undefined)).toBe(false)
+  }
+  for (const action of ["navigate", "click", "tabs.open", "tabs.focus"]) {
+    expect(desktopReadCommitGate(action, undefined)).toBe(true)
+  }
+})
diff --git a/packages/gui-extensions/src/browser/read-commit-gate.ts b/packages/gui-extensions/src/browser/read-commit-gate.ts
new file mode 100644
index 0000000000..bd830ae574
--- /dev/null
+++ b/packages/gui-extensions/src/browser/read-commit-gate.ts
@@ -0,0 +1,31 @@
+const legacyEffects = new Set([
+  "tabs.open", "tabs.focus", "tabs.close", "preview", "navigate", "back", "forward", "reload", "stop",
+  "click", "hover", "drag", "fill", "fill_form", "select", "check", "press", "scroll",
+  "files.upload", "files.drop",
+])
+
+/**
+ * Browser snapshots disclose page content. Never execute one from an IPC
+ * command unless the command carries a one-use Core/host read-commit ticket.
+ * Other actions cannot borrow this snapshot authority.
+ */
+export function desktopReadCommitGate(actionType: string, ticket: unknown): boolean {
+  if (actionType === "snapshot") return typeof ticket === "string" && ticket.length > 0
+  // Fail closed for every other content/inspection/capture command, including
+  // unknown future types. A snapshot grant is never interchangeable with them.
+  return ticket === undefined && legacyEffects.has(actionType)
+}
+
+/** The GUI may wait for a tab to load after read.commit. Revalidate *after*
+ * readiness and invoke the browser driver in the same JS turn as this check. */
+export async function startCommittedRead<T>(ready: Promise<unknown>, live: () => boolean,
+  execute: () => Promise<T>, coreLive: () => Promise<boolean>): Promise<T> {
+  await ready
+  if (live() !== true) throw new Error("Read-only Desktop attachment revoked before browser effect")
+  if (await coreLive() !== true) throw new Error("Core read lease revoked before Chromium effect")
+  // Core RPC may have awaited while this Desktop's attachment was replaced.
+  if (live() !== true) throw new Error("Read-only Desktop attachment revoked before Chromium effect")
+  const result = await execute()
+  if (live() !== true) throw new Error("Read-only Desktop attachment revoked before snapshot result")
+  return result
+}
