+    const reading = yield* target.requestOnce([], () => true).pipe(Effect.forkScoped({ startImmediately: true }))
+    const requestID = yield* Deferred.await(next)
+    expect(Exit.isFailure(yield* Effect.exit(commands.command({ ...impostor, requestID }, caller)))).toBe(true)
+    const real = yield* commands.command({ ...base, requestID }, caller)
