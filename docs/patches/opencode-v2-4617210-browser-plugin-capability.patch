index 0000000000..76d1123368
--- /dev/null
+++ b/packages/gui-extensions/src/browser/read-commit-gate.test.ts
@@ -0,0 +1,123 @@
+import { expect, test } from "bun:test"
+import { desktopReadCommitGate, startCommittedRead } from "./read-commit-gate"
+import { Browser } from "@opencode/plugin-browser/rpc"
+
+test("direct IPC snapshot without native host read commit is denied before any effect", () => {
+  let effects = 0
+  const dispatch = (type: string, ticket?: unknown) => {
+    if (!desktopReadCommitGate(type, ticket)) return false
+    effects++
+    return true
+  }
+  for (const forged of [undefined, null, "", false, 0]) {
+    expect(dispatch("snapshot", forged)).toBe(false)
+  }
+  expect(effects).toBe(0)
+  expect(dispatch("snapshot", "one-use-host-ticket")).toBe(true)
+  expect(effects).toBe(1)
+})
+
+test("a snapshot ticket never upgrades another desktop command", () => {
+  for (const action of ["navigate", "click", "fill", "submit", "tabs.list"]) {
+    expect(desktopReadCommitGate(action, "borrowed-read-ticket")).toBe(false)
+  }
+  expect(desktopReadCommitGate("tabs.list", undefined)).toBe(false)
+})
+
+test("direct IPC cannot bypass Core read authority through other page-content operations", () => {
+  for (const action of ["tabs.list", "frames", "find", "evaluate", "screenshot", "wait", "dialog",
+    "network.list", "network.get", "console", "files.list", "files.get", "trace.stop", "cpu.stop",
+    "heap.snapshot", "heap.object", "lighthouse", "arbitrary-future-read"]) {
+    expect(desktopReadCommitGate(action, undefined)).toBe(false)
+    expect(desktopReadCommitGate(action, "stolen-snapshot-token")).toBe(false)
+  }
+  // Keep host and Core connection policies in lockstep as operations evolve.
+  for (const operation of Browser.Operations) {
+    if (operation.name === "snapshot") continue
+    expect(desktopReadCommitGate(operation.name, undefined)).toBe(Browser.legacyActionAllowed(operation.name))
+  }
+})
+
+test("revoking the Desktop tab while page.ready is pending prevents browser execution", async () => {
+  let release!: () => void
+  const ready = new Promise<void>((resolve) => { release = resolve })
+  let live = true
+  let effects = 0
+  const reading = startCommittedRead(ready, () => live, async () => {
