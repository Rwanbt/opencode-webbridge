+          "3;ext=yes\r\na",
+          "bc\r\n4\r\ndefg\r",
+          "\n0\r\nX-Debug: test\r\n\r\n",
+        ]) {
+          socket.write(part)
+          await new Promise((resolve) => setTimeout(resolve, 3))
+        }
+        socket.end()
+      })()
+    })
+  })
+  await once(backend.listen(0, "127.0.0.1"), "listening")
