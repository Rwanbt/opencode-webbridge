+    connected.resolve(socket)
+    socket.once("close", () => ended.resolve())
+  })
+  await once(backend.listen(0, "127.0.0.1"), "listening")
+  const address = backend.address()
+  if (!address || typeof address === "string") throw new Error("No interrupted-upload fixture")
+  const reset = localFixture(address.port)
+  const tunnel = BrowserTunnel.make()
+  let proxy: Awaited<ReturnType<typeof BrowserProxy.make>> | undefined
+  let client: Socket | undefined
+  try {
