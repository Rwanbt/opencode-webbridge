+import { expect, test } from "bun:test"
+import type { Context } from "@opencode/plugin/effect/plugin"
+import { PluginBrowser } from "@opencode/core/plugin/browser"
+import { Plugin } from "@opencode/core/plugin"
+import { Permission } from "@opencode/core/permission"
+import { Session } from "@opencode/schema/session"
+import { Deferred, Effect, Exit, Scope } from "effect"
+import { testEffect } from "../lib/effect"
+import { PluginTestLayer } from "./fixture"
+
+const sessionID = Session.ID.make("ses_browser_capability")
+
+testEffect(PluginTestLayer).live(
+  "only a trusted builtin generation may register, even if source metadata is missing",
+  () =>
+    Effect.gen(function* () {
+      const plugins = yield* Plugin.Service
+      let registered = false
+      const impostor = {
+        id: "opencode.browser",
+        effect: (ctx: Context) =>
+          Effect.gen(function* () {
+            yield* ctx.browser
+              .register({
+                tabs: () => Effect.succeed([]),
+                snapshot: () => Effect.succeed({ content: "", truncated: false }),
+              })
+              .pipe(Effect.orDie)
+            registered = true
+          }),
+      }
+      yield* plugins.activate([{ ...impostor, revision: "forged-missing-source" }])
+      expect(registered).toBe(false)
+      yield* plugins.activate([{ ...impostor, source: { type: "builtin" }, revision: "forged-builtin-source" }])
+      expect(registered).toBe(false)
+    }),
+)
+
+function fixture(deny?: string) {
+  const calls: string[] = []
+  const actions: string[] = []
+  const broker = PluginBrowser.make({
+    browserPolicy: () => 0,
+    assert: (input) => {
+      actions.push(`${input.action}:${input.resources.join(",")}`)
+      return input.action === deny
+        ? Effect.fail(
+            new Permission.BlockedError({
+              permission: input.action,
+              resources: [...input.resources],
+              rules: [],
+            }),
+          )
+        : Effect.void
+    },
+  })
+  const firstParty = broker("opencode.browser", true)
+  const other = broker("demo-plugin")
+  const driver = {
+    tabs: () =>
+      Effect.sync(() => {
+        calls.push("tabs")
+        return [{ id: "tab_one", url: "https://example.com", title: "Example" }]
+      }),
+    snapshot: () =>
+      Effect.sync(() => {
+        calls.push("snapshot")
+        return { content: "fixture page", truncated: false }
+      }),
+  }
+  return { firstParty, other, driver, calls, actions }
+}
+
+test("unregistered host and unauthorized host registration fail without running browser", async () => {
+  const item = fixture()
+  const absent = await Effect.runPromiseExit(item.other.tabs({ sessionID }))
+  expect(Exit.isFailure(absent)).toBe(true)
+  const forbidden = await Effect.runPromiseExit(Effect.scoped(item.other.register(item.driver)))
+  expect(Exit.isFailure(forbidden)).toBe(true)
+  const spoof = PluginBrowser.make({ assert: () => Effect.void })("opencode.browser", false)
+  expect(Exit.isFailure(await Effect.runPromiseExit(Effect.scoped(spoof.register(item.driver))))).toBe(true)
+  expect(item.calls).toEqual([])
+  expect(item.actions).toEqual([])
+})
+
+test("read-only access requires browser AND plugin-specific grant", async () => {
+  for (const denied of ["browser", "browser_plugin"]) {
+    const item = fixture(denied)
+    await Effect.runPromise(
+      Effect.scoped(
+        Effect.gen(function* () {
+          yield* item.firstParty.register(item.driver)
+          expect(Exit.isFailure(yield* Effect.exit(item.other.tabs({ sessionID })))).toBe(true)
+          expect(Exit.isFailure(yield* Effect.exit(item.other.snapshot({ sessionID, tabID: "tab_one" })))).toBe(true)
+        }),
+      ),
+    )
+    expect(item.calls).toEqual([])
+  }
+  const granted = fixture()
+  await Effect.runPromise(
+    Effect.scoped(
+      Effect.gen(function* () {
+        yield* granted.firstParty.register(granted.driver)
+        expect(yield* granted.other.tabs({ sessionID })).toHaveLength(1)
+        expect(Exit.isFailure(yield* Effect.exit(granted.other.snapshot({ sessionID, tabID: "tab_one" })))).toBe(true)
+      }),
+    ),
+  )
+  expect(granted.calls).toEqual(["tabs"])
+  expect(granted.actions).toEqual([
+    "browser:*",
+    "browser_plugin:demo-plugin:tabs.list",
+    "browser:*",
+    "browser_plugin:demo-plugin:tabs.list",
+  ])
+  expect(Exit.isFailure(await Effect.runPromiseExit(granted.other.tabs({ sessionID })))).toBe(true)
+})
+
+test("host unload during a pending grant never executes an old browser host", async () => {
+  const started = Deferred.makeUnsafe<void>()
+  const release = Deferred.makeUnsafe<void>()
+  const calls: string[] = []
+  const broker = PluginBrowser.make({
+    browserPolicy: () => 0,
+    assert: (input) =>
+      input.action === "browser_plugin"
+        ? Deferred.succeed(started, undefined).pipe(Effect.andThen(Deferred.await(release)))
+        : Effect.void,
+  })
+  const host = broker("opencode.browser", true)
+  const other = broker("demo-plugin")
+  const scope = await Effect.runPromise(Scope.make())
+  await Effect.runPromise(
+    host
+      .register({
+        tabs: () =>
+          Effect.sync(() => {
+            calls.push("tabs")
+            return []
+          }),
+        snapshot: () => Effect.succeed({ content: "", truncated: false }),
+      })
+      .pipe(Effect.provideService(Scope.Scope, scope)),
+  )
+  const ready = Effect.runPromiseExit(other.tabs({ sessionID }))
+  await Effect.runPromise(Deferred.await(started))
+  await Effect.runPromise(Scope.close(scope, Exit.void))
+  await Effect.runPromise(Deferred.succeed(release, undefined))
+  const result = await ready
+  expect(Exit.isFailure(result)).toBe(true)
+  expect(calls).toEqual([])
+})
+
+test("revoking plugin grant while the last browser check waits never reaches the driver", async () => {
+  const waiting = Deferred.makeUnsafe<void>()
+  const resume = Deferred.makeUnsafe<void>()
+  let checks = 0
+  let revoked = false
+  const invoked: string[] = []
+  const broker = PluginBrowser.make({
+    browserPolicy: () => 0,
+    assert: (input) =>
+      Effect.gen(function* () {
+        if (input.action === "browser" && ++checks === 2) {
+          yield* Deferred.succeed(waiting, undefined)
+          yield* Deferred.await(resume)
+        }
+        if (input.action === "browser_plugin" && revoked)
+          return yield* new Permission.BlockedError({
+            permission: input.action,
+            resources: [...input.resources],
+            rules: [],
+          })
+      }),
+  })
+  const firstParty = broker("opencode.browser", true)
+  const caller = broker("demo-plugin")
+  await Effect.runPromise(
+    Effect.scoped(
+      Effect.gen(function* () {
+        yield* firstParty.register({
+          tabs: () =>
+            Effect.sync(() => {
+              invoked.push("tabs")
+              return []
+            }),
+          snapshot: () => Effect.succeed({ content: "", truncated: false }),
+        })
+        const result = Effect.runPromiseExit(caller.tabs({ sessionID }))
+        yield* Deferred.await(waiting)
+        revoked = true
+        yield* Deferred.succeed(resume, undefined)
+        expect(Exit.isFailure(yield* Effect.promise(() => result))).toBe(true)
+        expect(invoked).toEqual([])
+      }),
+    ),
+  )
+})
diff --git a/packages/core/test/plugin/browser-lease.test.ts b/packages/core/test/plugin/browser-lease.test.ts
new file mode 100644
index 0000000000..6e53adf475
--- /dev/null
+++ b/packages/core/test/plugin/browser-lease.test.ts
@@ -0,0 +1,228 @@
+import { test, expect } from "bun:test"
+import { BrowserLease } from "@opencode/core/plugin/browser-lease"
+import { Deferred, Effect, Exit } from "effect"
+
+const binding = {
+  pluginID: "reader",
+  pluginGeneration: "builtin-g1",
+  agentID: "build",
+  sessionID: "ses_A",
+  workspaceID: "wrk_A",
+  turnID: "msg_A",
+  callID: "call_A",
+  connectionID: "desktop_A",
+  tabID: "tab_A",
+  tabGeneration: 2,
+  action: "snapshot",
+} satisfies BrowserLease.Binding
+
+test("revocation during delayed user authorization fails before issuing any grant", async () => {
+  const waiting = Deferred.makeUnsafe<void>()
+  const resume = Deferred.makeUnsafe<void>()
+  const leases = BrowserLease.make({
+    authorize: () => Deferred.succeed(waiting, undefined).pipe(Effect.andThen(Deferred.await(resume))),
+    live: () => true,
+  })
+  const attempt = Effect.runPromiseExit(leases.issue(binding))
+  await Effect.runPromise(Deferred.await(waiting))
+  leases.revoke()
+  await Effect.runPromise(Deferred.succeed(resume, undefined))
+  expect(Exit.isFailure(await attempt)).toBe(true)
+  expect(leases.outstanding).toBe(0)
+})
+
+test("grant consumes only once and revocation between issue and dispatch refuses it", async () => {
+  const leases = BrowserLease.make({ authorize: () => Effect.void, live: () => true })
+  const first = await Effect.runPromise(leases.issue(binding))
+  expect(leases.consume(first, binding)).toBe(true)
+  expect(leases.consume(first, binding)).toBe(false)
+  const nextCall = { ...binding, callID: "call_next" }
+  const second = await Effect.runPromise(leases.issue(nextCall))
+  leases.revoke()
+  expect(leases.consume(second, nextCall)).toBe(false)
+})
+
+test("impostor plugin, different agent, workspace, turn, tab, connection and exact action fail", async () => {
+  for (const edit of [
+    { pluginID: "impostor" },
+    { pluginGeneration: "foreign-generation" },
+    { agentID: "different-agent" },
+    { sessionID: "ses_B" },
+    { workspaceID: "wrk_B" },
+    { turnID: "msg_B" },
+    { callID: "call_B" },
+    { connectionID: "reconnected" },
+    { tabID: "another-tab" },
+    { tabGeneration: 3 },
+    { action: "click" },
+  ]) {
+    const leases = BrowserLease.make({ authorize: () => Effect.void, live: () => true })
+    const ticket = await Effect.runPromise(leases.issue(binding))
+    expect(leases.consume(ticket, { ...binding, ...edit })).toBe(false)
+    expect(leases.consume(ticket, binding)).toBe(false)
+  }
+})
+
+test("driver reload, timeout and lifecycle retirement fail closed", async () => {
+  let alive = true
+  let time = 100
+  const leases = BrowserLease.make({ authorize: () => Effect.void, live: () => alive, clock: () => time, ttlMs: 5 })
+  const detached = await Effect.runPromise(leases.issue(binding))
+  alive = false
+  expect(leases.consume(detached, binding)).toBe(false)
+  alive = true
+  const nextCall = { ...binding, callID: "call_timeout" }
+  const expired = await Effect.runPromise(leases.issue(nextCall))
+  time += 5
+  expect(leases.consume(expired, nextCall)).toBe(false)
+  const finalCall = { ...binding, callID: "call_retired" }
+  const revoked = await Effect.runPromise(leases.issue(finalCall))
+  leases.retire()
+  expect(leases.consume(revoked, finalCall)).toBe(false)
+  expect(Exit.isFailure(await Effect.runPromiseExit(leases.issue(binding)))).toBe(true)
+})
+
+test("two competing consumers cannot both execute, even when launched together", async () => {
+  const leases = BrowserLease.make({ authorize: () => Effect.void, live: () => true })
+  const ticket = await Effect.runPromise(leases.issue(binding))
+  const results = await Promise.all([
+    Promise.resolve().then(() => leases.consume(ticket, binding)),
+    Promise.resolve().then(() => leases.consume(ticket, binding)),
+  ])
+  expect(results.filter(Boolean)).toHaveLength(1)
+})
+
+test("two overlapping issues of the same exact action cannot mint two usable tickets", async () => {
+  const waiting = Deferred.makeUnsafe<void>()
+  const resume = Deferred.makeUnsafe<void>()
+  const leases = BrowserLease.make({
+    authorize: () => Deferred.succeed(waiting, undefined).pipe(Effect.andThen(Deferred.await(resume))),
+    live: () => true,
+  })
+  const first = Effect.runPromiseExit(leases.issue(binding))
+  await Effect.runPromise(Deferred.await(waiting))
+  const duplicate = Effect.runPromiseExit(leases.issue(binding))
+  await Effect.runPromise(Deferred.succeed(resume, undefined))
+  const results = await Promise.all([first, duplicate])
+  expect(results.filter(Exit.isSuccess)).toHaveLength(1)
+  expect(results.filter(Exit.isFailure)).toHaveLength(1)
+  if (Exit.isSuccess(results[0])) expect(leases.consume(results[0].value, binding)).toBe(true)
+  expect(Exit.isFailure(await Effect.runPromiseExit(leases.issue(binding)))).toBe(true)
+})
+
+test("a malformed or incomplete binding is not authorized", async () => {
+  let calls = 0
+  const leases = BrowserLease.make({
+    authorize: () =>
+      Effect.sync(() => {
+        calls++
+      }),
+    live: () => true,
+  })
+  const incomplete = { pluginID: "reader" } as BrowserLease.Binding
+  expect(Exit.isFailure(await Effect.runPromiseExit(leases.issue(incomplete)))).toBe(true)
+  expect(Exit.isFailure(await Effect.runPromiseExit(leases.issue({ ...binding, tabGeneration: -1 })))).toBe(true)
+  expect(Exit.isFailure(await Effect.runPromiseExit(leases.issue({ ...binding, tabGeneration: "2" as never })))).toBe(
+    true,
+  )
+  expect(calls).toBe(0)
+})
+
+test("forged plugin generation fails against trusted live binding, including after reconnect", async () => {
+  let generation = "builtin-g1"
+  const leases = BrowserLease.make({
+    authorize: () => Effect.void,
+    live: (input) => input.pluginGeneration === generation,
+  })
+  expect(Exit.isFailure(await Effect.runPromiseExit(leases.issue({ ...binding, pluginGeneration: "forged" })))).toBe(
+    true,
+  )
+  const ticket = await Effect.runPromise(leases.issue(binding))
+  generation = "builtin-g2"
+  expect(leases.consume(ticket, binding)).toBe(false)
+})
+
+test("hanging permission authorization times out and issues no grant", async () => {
+  let allow = false
+  const leases = BrowserLease.make({
+    authorize: () => (allow ? Effect.void : Effect.never),
+    live: () => true,
+    authorizeTimeoutMs: 20,
+  })
+  expect(Exit.isFailure(await Effect.runPromiseExit(leases.issue(binding)))).toBe(true)
+  expect(leases.outstanding).toBe(0)
+  allow = true
+  const ticket = await Effect.runPromise(leases.issue(binding))
+  expect(leases.consume(ticket, binding)).toBe(true)
+})
+
+test("mutating a caller binding across an awaited permission cannot transfer an authorized principal", async () => {
+  const waiting = Deferred.makeUnsafe<void>()
+  const resume = Deferred.makeUnsafe<void>()
+  let checked: BrowserLease.Binding | undefined
+  const leases = BrowserLease.make({
+    authorize: (actual) =>
+      Effect.sync(() => {
+        checked = { ...actual }
+      }).pipe(Effect.andThen(Deferred.succeed(waiting, undefined)), Effect.andThen(Deferred.await(resume))),
+    live: () => true,
+  })
+  const mutable = { ...binding }
+  const attempt = Effect.runPromiseExit(leases.issue(mutable))
+  await Effect.runPromise(Deferred.await(waiting))
+  mutable.pluginID = "impostor"
+  mutable.sessionID = "foreign-session"
+  mutable.action = "click"
+  await Effect.runPromise(Deferred.succeed(resume, undefined))
+  expect(checked).toEqual(binding)
+  expect(Exit.isFailure(await attempt)).toBe(true)
+  expect(leases.outstanding).toBe(0)
+})
+
+test("revoking an epoch cannot un-burn a consumed or in-flight tool call", async () => {
+  const leases = BrowserLease.make({ authorize: () => Effect.void, live: () => true })
+  const first = await Effect.runPromise(leases.issue(binding))
+  expect(leases.consume(first, binding)).toBe(true)
+  leases.revoke()
+  expect(Exit.isFailure(await Effect.runPromiseExit(leases.issue(binding)))).toBe(true)
+  const nextCall = { ...binding, callID: "call_next_epoch" }
+  const pending = await Effect.runPromise(leases.issue(nextCall))
+  leases.revoke()
+  expect(leases.consume(pending, nextCall)).toBe(false)
+  expect(Exit.isFailure(await Effect.runPromiseExit(leases.issue(nextCall)))).toBe(true)
+  const trulyNewCall = { ...binding, callID: "call_after_reconnect", connectionID: "desktop_B" }
+  const newTicket = await Effect.runPromise(leases.issue(trulyNewCall))
+  expect(leases.consume(newTicket, trulyNewCall)).toBe(true)
+})
+
+test("lease expiration uses a monotonic clock and refuses unsafe TTL settings", async () => {
+  let tick = 100
+  const leases = BrowserLease.make({
+    authorize: () => Effect.void,
+    live: () => true,
+    clock: () => tick,
+    ttlMs: 5,
+  })
+  const issued = await Effect.runPromise(leases.issue(binding))
+  tick = 90 // Wall-clock regression must never extend the authorization.
+  expect(leases.consume(issued, binding)).toBe(false)
+  expect(() => BrowserLease.make({ authorize: () => Effect.void, live: () => true, ttlMs: Infinity })).toThrow()
+})
+
+test("live authority revocation at issuance and at consumption is observed after predicate returns", async () => {
+  let revokeOn = 2
+  let reads = 0
+  let ledger: ReturnType<typeof BrowserLease.make>
+  ledger = BrowserLease.make({
+    authorize: () => Effect.void,
+    live: () => {
+      if (++reads === revokeOn) ledger.revoke()
+      return true
+    },
+  })
+  expect(Exit.isFailure(await Effect.runPromiseExit(ledger.issue(binding)))).toBe(true)
+  revokeOn = 5
+  const next = { ...binding, callID: "after_issue_revoke" }
+  const ticket = await Effect.runPromise(ledger.issue(next))
+  expect(ledger.consume(ticket, next)).toBe(false)
+})
