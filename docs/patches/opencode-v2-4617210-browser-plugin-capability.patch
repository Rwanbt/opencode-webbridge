@@ -0,0 +1,194 @@
+import type { IncomingHttpHeaders, IncomingMessage, ServerResponse } from "node:http"
+import { once } from "node:events"
+import type { Duplex } from "node:stream"
+
+// The Bun node:http ClientRequest adapter ignores Agent.createConnection and
+// fetches the URL directly. This codec operates ONLY on an already authorized
+// TunnelSocket; it never opens a destination socket or resolves a hostname.
+const MAX_HEADERS = 64 * 1024
+const MAX_LINE = 8 * 1024
+
+class Reader {
+  private readonly source: AsyncIterator<Buffer>
+  private buffer = Buffer.alloc(0)
+  constructor(socket: Duplex) {
+    this.source = socket[Symbol.asyncIterator]() as AsyncIterator<Buffer>
+  }
+  async fill(): Promise<boolean> {
+    if (this.buffer.length) return true
+    const next = await this.source.next()
+    if (next.done) return false
+    this.buffer = Buffer.from(next.value)
+    return true
+  }
+  async read(size: number): Promise<Buffer> {
+    if (!(await this.fill())) throw new Error("Truncated upstream HTTP response")
+    const part = this.buffer.subarray(0, Math.min(size, this.buffer.length))
+    this.buffer = this.buffer.subarray(part.length)
+    return part
+  }
+  async exact(size: number): Promise<Buffer> {
+    const chunks: Buffer[] = []
+    let left = size
+    while (left) {
+      const part = await this.read(left)
+      chunks.push(part)
+      left -= part.length
+    }
+    return Buffer.concat(chunks, size)
+  }
+  async line(limit = MAX_LINE): Promise<string> {
+    const chunks: Buffer[] = []
+    let size = 0
+    while (true) {
+      if (!(await this.fill())) throw new Error("Incomplete upstream HTTP headers")
+      const at = this.buffer.indexOf("\r\n")
+      if (at !== -1) {
+        size += at
+        if (size > limit) throw new Error("Upstream HTTP header line too long")
+        chunks.push(this.buffer.subarray(0, at))
+        this.buffer = this.buffer.subarray(at + 2)
+        return Buffer.concat(chunks).toString("latin1")
+      }
+      size += this.buffer.length
+      if (size > limit) throw new Error("Upstream HTTP header line too long")
+      chunks.push(this.buffer)
+      this.buffer = Buffer.alloc(0)
+    }
+  }
+  async untilEOF(push: (buffer: Buffer) => Promise<void>) {
+    while (await this.fill()) await push(await this.read(this.buffer.length))
+  }
+}
+
+async function write(socket: Duplex, bytes: Uint8Array | string) {
+  if (socket.destroyed) throw new Error("Browser tunnel closed during HTTP upload")
+  if (!socket.write(bytes)) await once(socket, "drain")
+}
+
+export async function forwardHttp(
+  incoming: IncomingMessage,
+  response: ServerResponse,
+  tunnel: Duplex,
+  url: URL,
+  headers: IncomingHttpHeaders,
+) {
+  const host = url.host
+  headers.host = host
+  headers.connection = "close"
+  const hasLength = headers["content-length"] !== undefined
+  const chunkedUpload = !hasLength && incoming.headers["transfer-encoding"] !== undefined
+  if (chunkedUpload) headers["transfer-encoding"] = "chunked"
+  const headerLines = Object.entries(headers).flatMap(([key, value]) =>
+    value === undefined ? [] : (Array.isArray(value) ? value : [value]).map((item) => `${key}: ${item}\r\n`))
