+import { expect, test } from "bun:test"
+import { Cause, Deferred, Effect, Exit, Fiber, Stream } from "effect"
+import { AbsolutePath } from "@opencode/schema/schema"
+import { Location } from "@opencode/schema/location"
+import { Project } from "@opencode/schema/project"
+import { Session } from "@opencode/schema/session"
+import { Workspace } from "@opencode/schema/workspace"
+import { BrowserConnection } from "../src/connection"
+
+test("a Desktop registration from a distinct workspace with the same directory is refused", async () => {
+  const directory = AbsolutePath.make("/workspace")
+  const sessionID = Session.ID.make("ses_other_workspace")
+  const attached = Deferred.makeUnsafe<void>()
+  let workspaceID = Workspace.ID.make("wrk_other")
+  let attach:
+    | ((
+        input: { sessionID: Session.ID; connectionID: string; attachmentProof: string; version: 6 },
+        caller: {
+          error: (type: string, message: string, data: object) => Error
+        },
+      ) => Effect.Effect<unknown, unknown>)
+    | undefined
+  const ctx = {
+    location: new Location.Info({
+      directory,
+      workspaceID: Workspace.ID.make("wrk_owner"),
+      project: { id: Project.ID.global, directory, canonical: directory },
+    }),
+    agent: { transform: () => Effect.void },
+    event: { subscribe: () => Stream.empty },
+    session: {
+      get: () => Effect.succeed({ location: { directory, workspaceID } }),
+      update: () => Effect.void,
+    },
+    rpc: {
+      register: (_schema: unknown, handlers: { attach: typeof attach }) => {
+        attach = handlers.attach
+        return Effect.succeed({ events: { emit: () => Deferred.succeed(attached, undefined) } })
+      },
+    },
+  } as unknown as Parameters<typeof BrowserConnection.make>[0]
+  const result = await Effect.runPromise(
+    Effect.scoped(
+      Effect.gen(function* () {
+        yield* BrowserConnection.make(ctx, { verify: () => Effect.succeed(true) })
+        if (!attach) throw new Error("Browser RPC not registered")
+        const caller = { error: (_type: string, message: string) => new Error(message) }
+        const refused = yield* Effect.exit(
+          attach({ sessionID, connectionID: "desktop_wrong", attachmentProof: crypto.randomUUID(), version: 6 }, caller).pipe(Effect.timeout("1 second")),
+        )
+        workspaceID = Workspace.ID.make("wrk_owner")
+        const running = yield* attach({ sessionID, connectionID: "desktop_owner", attachmentProof: crypto.randomUUID(), version: 6 }, caller).pipe(
+          Effect.forkScoped({ startImmediately: true }),
+        )
+        yield* Deferred.await(attached)
+        yield* Fiber.interrupt(running)
+        return refused
+      }),
+    ),
+  )
+  expect(Exit.isFailure(result)).toBe(true)
+  if (Exit.isFailure(result)) expect(Cause.pretty(result.cause)).toContain("Session belongs to another location")
+})
+
+test("an attachment cannot use a private RPC or TCP tunnel while its session permission update is pending", async () => {
+  const directory = AbsolutePath.make("/workspace")
+  const sessionID = Session.ID.make("ses_pending_activation")
+  const updateStarted = Deferred.makeUnsafe<void>()
+  const resumeGrant = Deferred.makeUnsafe<void>()
+  const announced = Deferred.makeUnsafe<void>()
+  let commands: Record<string, (input: any, caller: any) => any> = {}
+  const location = new Location.Info({ directory, workspaceID: Workspace.ID.make("wrk_owner"),
+    project: { id: Project.ID.global, directory, canonical: directory } })
+  const ctx = {
+    location,
+    agent: { transform: () => Effect.void },
+    event: { subscribe: () => Stream.empty },
+    session: {
+      get: () => Effect.succeed({ location, permissions: [] }),
+      update: () => Deferred.succeed(updateStarted, undefined).pipe(Effect.andThen(Deferred.await(resumeGrant))),
+    },
+    rpc: { register: (_schema: unknown, handlers: typeof commands) => {
+      commands = handlers
+      return Effect.succeed({ events: { emit: () => Deferred.succeed(announced, undefined) } })
+    } },
+  } as unknown as Parameters<typeof BrowserConnection.make>[0]
+  await Effect.runPromise(Effect.scoped(Effect.gen(function* () {
+    yield* BrowserConnection.make(ctx, { verify: () => Effect.succeed(true) })
+    const caller = { error: (_type: string, message: string) => new Error(message) }
+    const base = { sessionID, connectionID: "public-id", attachmentProof: crypto.randomUUID() }
+    const pending = yield* commands.attach({ ...base, version: 6 }, caller)
+      .pipe(Effect.forkScoped({ startImmediately: true }))
+    yield* Deferred.await(updateStarted)
+    expect(Exit.isFailure(yield* Effect.exit(commands.state({ ...base,
+      state: { tabs: [], focusedTabID: null } }, caller)))).toBe(true)
+    const deniedTunnel = yield* Effect.exit(commands["tunnel.open"]({ ...base,
+      target: { host: "127.0.0.1", port: 1 } }, caller))
+    expect(Exit.isFailure(deniedTunnel)).toBe(true)
+    // ECONNREFUSED after a real TCP attempt is NOT a security-gate success.
+    if (Exit.isFailure(deniedTunnel))
+      expect(Cause.pretty(deniedTunnel.cause)).toContain("Browser attachment is unavailable")
+    yield* Deferred.succeed(resumeGrant, undefined)
+    yield* Deferred.await(announced)
+    expect(Exit.isSuccess(yield* Effect.exit(commands.state({ ...base,
+      state: { tabs: [], focusedTabID: null } }, caller)))).toBe(true)
+    yield* Fiber.interrupt(pending)
+  })) as Effect.Effect<void, unknown, never>)
+})
