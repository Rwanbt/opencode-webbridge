+    session: { get: () => Effect.succeed({ location }), update: () => Effect.void },
+    rpc: { register: (_: unknown, handlers: any) => {
+      commands = handlers
+      return Effect.succeed({ events: { emit: (_: string, event: any) =>
+        event.type === "command" ? Deferred.succeed(next, event.requestID)
+          : event.type === "attached" ? Deferred.succeed(attached, undefined) : Effect.void } })
+    } },
+  } as unknown as Parameters<typeof BrowserConnection.make>[0]
+  const caller = { error: (_: string, msg: string) => new Error(msg) }
+  await Effect.runPromise(Effect.scoped(Effect.gen(function* () {
+    const scope = yield* BrowserConnection.make(ctx)
+    const attachedFiber = yield* commands.attach({ sessionID, connectionID, attachmentProof, version: 6 }, caller)
+      .pipe(Effect.forkScoped({ startImmediately: true }))
+    yield* Deferred.await(attached)
+    yield* commands.state({ sessionID, connectionID, attachmentProof, state: state(1) }, caller)
+    const target = yield* scope.target(sessionID, { type: "snapshot", tabID })
+    yield* run({ target, commands, next, base: { sessionID, connectionID, attachmentProof }, scope }) as Effect.Effect<void, unknown>
+    yield* Fiber.interrupt(attachedFiber)
+  })) as Effect.Effect<void, unknown, never>)
+}
