+      "169.254.169.254", "192.168.1.1", "localhost", "2001:db8::1"]) {
+      const denied = await Effect.runPromiseExit(tunnel.open({ host, port: 443 }))
+      expect(Exit.isFailure(denied)).toBe(true)
