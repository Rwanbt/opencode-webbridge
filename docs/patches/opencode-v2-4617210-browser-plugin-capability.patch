diff --git a/packages/plugin-browser/test/connection-location.test.ts b/packages/plugin-browser/test/connection-location.test.ts
new file mode 100644
index 0000000000..cbfd5b5d12
--- /dev/null
+++ b/packages/plugin-browser/test/connection-location.test.ts
@@ -0,0 +1,63 @@
+import { expect, test } from "bun:test"
+import { Cause, Deferred, Effect, Exit, Fiber, Stream } from "effect"
+import { AbsolutePath } from "@opencode/schema/schema"
+import { Location } from "@opencode/schema/location"
+import { Project } from "@opencode/schema/project"
+import { Session } from "@opencode/schema/session"
+import { Workspace } from "@opencode/schema/workspace"
+import { BrowserConnection } from "../src/connection"
+
+test("a Desktop registration from a distinct workspace with the same directory is refused", async () => {
+  const directory = AbsolutePath.make("/workspace")
+  const sessionID = Session.ID.make("ses_other_workspace")
+  const attached = Deferred.makeUnsafe<void>()
+  let workspaceID = Workspace.ID.make("wrk_other")
+  let attach:
+    | ((
+        input: { sessionID: Session.ID; connectionID: string; version: 4 },
+        caller: {
+          error: (type: string, message: string, data: object) => Error
+        },
+      ) => Effect.Effect<unknown, unknown>)
+    | undefined
+  const ctx = {
+    location: new Location.Info({
+      directory,
+      workspaceID: Workspace.ID.make("wrk_owner"),
+      project: { id: Project.ID.global, directory, canonical: directory },
+    }),
+    agent: { transform: () => Effect.void },
+    event: { subscribe: () => Stream.empty },
+    session: {
+      get: () => Effect.succeed({ location: { directory, workspaceID } }),
+      update: () => Effect.void,
+    },
+    rpc: {
+      register: (_schema: unknown, handlers: { attach: typeof attach }) => {
+        attach = handlers.attach
+        return Effect.succeed({ events: { emit: () => Deferred.succeed(attached, undefined) } })
+      },
+    },
+  } as unknown as Parameters<typeof BrowserConnection.make>[0]
+  const result = await Effect.runPromise(
+    Effect.scoped(
+      Effect.gen(function* () {
+        yield* BrowserConnection.make(ctx)
+        if (!attach) throw new Error("Browser RPC not registered")
+        const caller = { error: (_type: string, message: string) => new Error(message) }
+        const refused = yield* Effect.exit(
+          attach({ sessionID, connectionID: "desktop_wrong", version: 4 }, caller).pipe(Effect.timeout("1 second")),
+        )
+        workspaceID = Workspace.ID.make("wrk_owner")
+        const running = yield* attach({ sessionID, connectionID: "desktop_owner", version: 4 }, caller).pipe(
+          Effect.forkScoped({ startImmediately: true }),
+        )
+        yield* Deferred.await(attached)
+        yield* Fiber.interrupt(running)
+        return refused
+      }),
+    ),
+  )
+  expect(Exit.isFailure(result)).toBe(true)
+  if (Exit.isFailure(result)) expect(Cause.pretty(result.cause)).toContain("Session belongs to another location")
+})
diff --git a/packages/plugin/src/effect/browser.ts b/packages/plugin/src/effect/browser.ts
