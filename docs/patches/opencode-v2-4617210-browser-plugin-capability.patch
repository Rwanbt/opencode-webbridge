+++ b/packages/plugin-browser/test/read-commit.test.ts
@@ -0,0 +1,334 @@
+import { expect, spyOn, test } from "bun:test"
+import { Cause, Deferred, Effect, Exit, Fiber, Stream } from "effect"
+import { AbsolutePath } from "@opencode/schema/schema"
+import { Location } from "@opencode/schema/location"
+import { Project } from "@opencode/schema/project"
+import { Session } from "@opencode/schema/session"
+import { Workspace } from "@opencode/schema/workspace"
+import { BrowserConnection } from "../src/connection"
+import { Browser } from "../src/rpc"
+
+const sessionID = Session.ID.make("ses_read_1")
+const connectionID = "desktop-live"
+const attachmentProof = "00000000-0000-4000-8000-000000000002"
+const tabID = Browser.TabID.make("tab_00000000-0000-4000-8000-000000000001")
+const state = (generation: number) => ({
+  focusedTabID: tabID,
+  tabs: [{ id: tabID, url: "http://127.0.0.1:3000/", title: "Offline chat", loading: false,
+    canGoBack: false, canGoForward: false, generation }],
+})
+
+async function harness(run: (x: {
+  target: any
+  commands: Record<string, (input: any, caller: any) => any>
+  next: Deferred.Deferred<string>
+  base: { sessionID: Session.ID; connectionID: string; attachmentProof: string }
+  scope: any
+}) => any) {
+  const directory = AbsolutePath.make("/local-fixture")
+  const location = new Location.Info({ directory, workspaceID: Workspace.ID.make("wrk_local"),
+    project: { id: Project.ID.global, directory, canonical: directory } })
+  let commands: any
+  const next = Deferred.makeUnsafe<string>()
+  const attached = Deferred.makeUnsafe<void>()
+  const ctx = {
+    location,
+    agent: { transform: () => Effect.void },
+    event: { subscribe: () => Stream.empty },
+    session: { get: () => Effect.succeed({ location }), update: () => Effect.void },
+    rpc: { register: (_: unknown, handlers: any) => {
+      commands = handlers
+      return Effect.succeed({ events: { emit: (_: string, event: any) =>
+        event.type === "command" ? Deferred.succeed(next, event.requestID)
+          : event.type === "attached" ? Deferred.succeed(attached, undefined) : Effect.void } })
+    } },
+  } as unknown as Parameters<typeof BrowserConnection.make>[0]
+  const caller = { error: (_: string, msg: string) => new Error(msg) }
+  await Effect.runPromise(Effect.scoped(Effect.gen(function* () {
+    const scope = yield* BrowserConnection.make(ctx, { verify: () => Effect.succeed(true) })
+    const attachedFiber = yield* commands.attach({ sessionID, connectionID, attachmentProof, version: 6 }, caller)
+      .pipe(Effect.forkScoped({ startImmediately: true }))
+    yield* Deferred.await(attached)
+    yield* commands.state({ sessionID, connectionID, attachmentProof, state: state(1) }, caller)
+    const target = yield* scope.target(sessionID, { type: "snapshot", tabID })
+    yield* run({ target, commands, next, base: { sessionID, connectionID, attachmentProof }, scope }) as Effect.Effect<void, unknown>
+    yield* Fiber.interrupt(attachedFiber)
+  })) as Effect.Effect<void, unknown, never>)
+}
+
+test("read-only host commit burns one grant before rendering and rejects forged/duplicate commit", async () => {
+  await harness(({ target, commands, next, base }) => Effect.gen(function* () {
+    const first = yield* target.requestOnce([], () => true).pipe(Effect.forkScoped({ startImmediately: true }))
+    const requestID = yield* Deferred.await(next)
+    const caller = { error: (_: string, msg: string) => new Error(msg) }
+    const command = yield* commands.command({ ...base, requestID }, caller)
+    expect(command.action.type).toBe("snapshot")
+    expect(typeof command.readCommit).toBe("string")
+    expect(yield* commands["read.commit"]({ ...base, requestID, ticket: "forged" }, caller)).toBe(false)
+    expect(yield* commands["read.commit"]({ ...base, requestID, ticket: command.readCommit }, caller)).toBe(false)
+    expect(Exit.isFailure(yield* Effect.exit(commands.result({ ...base, requestID, outcome: { type: "success", result: {
+      value: { content: "WEBBRIDGE_LOCAL_PAGE_OK:fixture", truncated: false }, files: [],
+    } } }, caller)))).toBe(true)
+    yield* Fiber.interrupt(first)
+    expect(Exit.isFailure(yield* Effect.exit(target.requestOnce([], () => true)))).toBe(true)
+  }))
+})
+
+test("tab metadata uses only the Core session mirror and does not bypass native read.commit", async () => {
+  await harness(({ scope, commands, base, next }) => Effect.gen(function* () {
+    const first = yield* scope.tabs(sessionID)
+    expect(first.tabs.map((tab: Browser.Tab) => tab.title)).toEqual(["Offline chat"])
+    expect(first.focusedTabID).toBe(tabID)
+    // Legacy target.request tabs.list still cannot reach native IPC.
+    const legacy = yield* scope.target(sessionID, { type: "tabs.list" })
+    expect(Exit.isFailure(yield* Effect.exit(legacy.request([])))).toBe(true)
+    const caller = { error: (_: string, message: string) => new Error(message) }
+    const impersonator = { ...base, attachmentProof: crypto.randomUUID() }
+    expect(Exit.isFailure(yield* Effect.exit(commands.state({ ...impersonator, state: state(99) }, caller)))).toBe(true)
+    expect((yield* scope.tabs(sessionID)).tabs[0]?.generation).toBe(1)
+    yield* commands.state({ ...base, state: state(2) }, caller)
+    expect((yield* scope.tabs(sessionID)).tabs[0]?.generation).toBe(2)
+    expect(first.tabs[0]?.generation).toBe(1) // Detached snapshot, not live state.
+    expect(Exit.isFailure(yield* Effect.exit(scope.tabs(Session.ID.make("ses_other"))))).toBe(true)
+    expect(Exit.isFailure(yield* Effect.exit(Deferred.await(next).pipe(Effect.timeout("50 millis"))))).toBe(true)
+  }))
+})
+
+test("single valid host commit authorizes one read-only snapshot response", async () => {
+  await harness(({ target, commands, next, base }) => Effect.gen(function* () {
+    const reading = yield* target.requestOnce([], () => true).pipe(Effect.forkScoped({ startImmediately: true }))
+    const requestID = yield* Deferred.await(next)
+    const caller = { error: (_: string, msg: string) => new Error(msg) }
+    const command = yield* commands.command({ ...base, requestID }, caller)
+    expect(yield* commands["read.commit"]({ ...base, requestID, ticket: command.readCommit }, caller)).toBe(true)
+    expect(yield* commands["read.commit"]({ ...base, requestID, ticket: command.readCommit }, caller)).toBe(false)
+    expect(yield* commands["read.live"]({ ...base, requestID, ticket: command.readCommit }, caller)).toBe(true)
+    yield* commands.result({ ...base, requestID, outcome: { type: "success", result: {
+      value: { content: "WEBBRIDGE_LOCAL_PAGE_OK:fixture", truncated: false }, files: [],
+    } } }, caller)
+    const response = (yield* Fiber.join(reading)) as { value: { content: string } }
+    expect(response.value.content).toBe("WEBBRIDGE_LOCAL_PAGE_OK:fixture")
+    expect(Exit.isFailure(yield* Effect.exit(target.requestOnce([], () => true)))).toBe(true)
+  }))
+})
+
+test("Core read.live receipt is one-use even with the exact ticket and attachment proof", async () => {
+  await harness(({ target, commands, next, base }) => Effect.gen(function* () {
+    const reading = yield* target.requestOnce([], () => true).pipe(Effect.forkScoped({ startImmediately: true }))
+    const requestID = yield* Deferred.await(next)
+    const caller = { error: (_: string, message: string) => new Error(message) }
+    const command = yield* commands.command({ ...base, requestID }, caller)
+    const input = { ...base, requestID, ticket: command.readCommit }
+    expect(yield* commands["read.commit"](input, caller)).toBe(true)
+    expect(yield* commands["read.live"](input, caller)).toBe(true)
+    expect(yield* commands["read.live"](input, caller)).toBe(false)
+    yield* commands.result({ ...base, requestID, outcome: { type: "success", result: {
+      value: { content: "single authorized read", truncated: false }, files: [],
+    } } }, caller)
+    const response = (yield* Fiber.join(reading)) as { value: { content: string } }
+    expect(response.value.content).toBe("single authorized read")
+  }))
+})
+
+test("Core denies page content arriving after the authorized read deadline", async () => {
+  let now = 1000
+  const clock = spyOn(performance, "now").mockImplementation(() => now)
+  try {
+    await harness(({ target, commands, next, base }) => Effect.gen(function* () {
+      const reading = yield* target.requestOnce([], () => true).pipe(Effect.forkScoped({ startImmediately: true }))
+      const requestID = yield* Deferred.await(next)
+      const caller = { error: (_: string, message: string) => new Error(message) }
+      const command = yield* commands.command({ ...base, requestID }, caller)
+      const input = { ...base, requestID, ticket: command.readCommit }
+      expect(yield* commands["read.commit"](input, caller)).toBe(true)
+      expect(yield* commands["read.live"](input, caller)).toBe(true)
+      now = 6001 // 5000ms from dispatch elapsed while the browser was pending.
+      expect(Exit.isFailure(yield* Effect.exit(commands.result({ ...base, requestID,
+        outcome: { type: "success", result: {
+          value: { content: "late private page", truncated: false }, files: [],
+        } },
+      }, caller)))).toBe(true)
+      expect(Exit.isFailure(yield* Fiber.await(reading))).toBe(true)
+    }))
+  } finally {
+    clock.mockRestore()
+  }
+})
+
+test("a forged or stale Desktop cannot disclose a committed snapshot without Core read.live", async () => {
+  await harness(({ target, commands, next, base }) => Effect.gen(function* () {
