+    yield* Effect.addFinalizer(() => unsubscribe)
+    const ticket = yield* permission.browserRead!.issue(binding)
+    const request = yield* Deferred.await(asked)
+    expect(request.action).toBe("browser_plugin")
+    expect(request.resources).toEqual([
+      [binding.pluginID, binding.pluginGeneration, binding.action, binding.workspaceID, binding.sessionID,
+        binding.turnID, binding.callID, binding.connectionID, binding.tabID, binding.tabGeneration].join(":"),
+    ])
+    expect(request.save).toEqual([])
+    expect(permission.browserRead!.consume(ticket, binding)).toBe(true)
+  }),
+)
+
+test.effect("saved wildcard cannot override a configured browser_plugin deny", () =>
+  Effect.gen(function* () {
+    yield* setup([
+      { action: "browser", resource: "*", effect: "allow" },
+      { action: "browser_plugin", resource: "*", effect: "deny" },
+    ])
+    const saved = yield* PermissionSaved.Service
+    yield* saved.add({ projectID: Project.ID.global, action: "browser_plugin", resources: ["*"] })
+    const permission = yield* Permission.Service
+    expect(Exit.isFailure(yield* Effect.exit(permission.browserRead!.issue(binding)))).toBe(true)
+    expect(permission.browserRead!.outstanding).toBe(0)
+    expect(yield* permission.list()).toEqual([])
+  }),
+)
+
+test.effect("real Core epoch is consumed before the broker may read; revocation before effect refuses", () =>
+  Effect.gen(function* () {
+    yield* setup([
+      { action: "browser", resource: "*", effect: "allow" },
+      { action: "browser_plugin", resource: "*", effect: "allow" },
+    ])
+    const permission = yield* Permission.Service
+    const location = Location.Ref.make({ directory: AbsolutePath.make("/project"),
+      workspaceID: "wrk_scoped" as never })
+    let lookups = 0
+    let reads = 0
+    let hostProof: (() => boolean) | undefined
+    let revokeBeforeConsume = false
+    const broker = PluginBrowser.make(permission, {
+      location,
+      session: () => Effect.sync(() => {
+        if (++lookups % 2 === 0 && revokeBeforeConsume) permission.browserRead!.revoke()
+        return location
+      }),
+    })
+    const builtin = broker("opencode.browser", true)
+    const caller = broker("fixture.reader")
+    yield* builtin.register({
+      tabs: () => Effect.succeed([]),
+      snapshot: () => Effect.die("legacy snapshot must stay blocked"),
+      bindSnapshot: () => Effect.succeed({
+        binding: { connectionID: "local_fixture", tabGeneration: 1 },
+        read: (stillAuthorized) => Effect.sync(() => {
+          hostProof = stillAuthorized
+          if (!stillAuthorized()) throw new Error("Core permission revoked before Desktop read")
+          reads++
+          return { content: "offline", truncated: false }
+        }),
+      }),
+    })
+    const context = (id: string) => ({
+      sessionID, messageID: SessionMessage.ID.make("msg_authorized"),
+      id: Tool.CallID.make(id), agent: Agent.ID.make("test"), progress: () => Effect.void,
+    })
+    const first = context("call_approved")
+    expect((yield* BrowserTurn.withContext(first, caller.snapshotOnce({ context: first, tabID: "tab_local" }))).content)
+      .toBe("offline")
+    expect(hostProof?.()).toBe(true)
+    permission.browserRead!.revoke()
+    expect(hostProof?.()).toBe(false) // A host delayed beyond Core consume may no longer commit.
+    revokeBeforeConsume = true
+    const denied = context("call_revoked")
+    expect(Exit.isFailure(yield* Effect.exit(BrowserTurn.withContext(denied,
+      caller.snapshotOnce({ context: denied, tabID: "tab_local" }))))).toBe(true)
+    expect(reads).toBe(1)
+  }),
+)
diff --git a/packages/core/test/plugin/browser-capability.test.ts b/packages/core/test/plugin/browser-capability.test.ts
