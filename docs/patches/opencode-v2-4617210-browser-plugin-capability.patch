+    expect(Exit.isFailure(forgedState)).toBe(true)
+    const deniedTunnel = yield* Effect.exit(commands["tunnel.open"]({ ...impostor,
+      target: { host: "127.0.0.1", port: 1 } }, caller))
+    expect(Exit.isFailure(deniedTunnel)).toBe(true)
