+  expect(publicAddress("2606:4700:4700::1111", 6)).toBe(true)
+  for (const address of ["0.0.0.1", "100.64.0.1", "172.31.0.1", "198.19.0.1",
+    "192.0.2.1", "203.0.113.1", "224.0.0.1", "255.255.255.255"]) {
