+test("server-operator exact loopback allowlist restores one native fixture endpoint, never its neighbors", async () => {
+  const server = createServer((socket) => socket.end("allowed"))
+  await once(server.listen(0, "127.0.0.1"), "listening")
+  const address = server.address()
+  if (!address || typeof address === "string") throw new Error("No test listener")
+  const key = "OPENCODE_BROWSER_TUNNEL_ALLOWED_PRIVATE_TARGETS"
+  const before = process.env[key]
+  process.env[key] = `127.0.0.1:${address.port}`
+  const tunnel = BrowserTunnel.make()
+  try {
+    const approved = await Effect.runPromise(tunnel.open({ host: "127.0.0.1", port: address.port }))
+    expect(approved).toBeTruthy()
+    expect(Buffer.from((await Effect.runPromise(tunnel.read(approved))).data).toString()).toBe("allowed")
+    const denied = await Effect.runPromiseExit(tunnel.open({ host: "127.0.0.1", port: address.port + 1 }))
+    expect(Exit.isFailure(denied)).toBe(true)
+    const spoof = await Effect.runPromiseExit(tunnel.open({
+      host: "localhost", port: address.port, trusted: true,
+    } as any))
+    expect(Exit.isFailure(spoof)).toBe(true)
+  } finally {
+    tunnel.dispose()
+    if (before === undefined) delete process.env[key]
+    else process.env[key] = before
+    await new Promise<void>((resolve) => server.close(() => resolve()))
+  }
+})
