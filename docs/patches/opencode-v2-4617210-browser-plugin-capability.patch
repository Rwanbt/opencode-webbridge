+import type { Effect, Scope } from "effect"
+import type { Session } from "@opencode/schema/session"
+
+/** Read-only desktop browser capability. Every call asks for a plugin-specific grant. */
+export interface BrowserDomain {
+  readonly tabs: (input: { readonly sessionID: Session.ID }) => Effect.Effect<ReadonlyArray<BrowserTab>, Error>
+  readonly snapshot: (input: {
+    readonly sessionID: Session.ID
+    readonly tabID: string
+  }) => Effect.Effect<BrowserSnapshot, Error>
+  /** Only the built-in opencode.browser plugin may register the Desktop host. */
+  readonly register: (driver: BrowserDriver) => Effect.Effect<void, Error, Scope.Scope>
+}
+
+export interface BrowserDriver {
+  readonly tabs: BrowserDomain["tabs"]
+  readonly snapshot: BrowserDomain["snapshot"]
+}
+
+export interface BrowserTab {
+  readonly id: string
+  readonly url: string
+  readonly title: string
+}
+
+export interface BrowserSnapshot {
+  readonly content: string
+  readonly truncated: boolean
+}
