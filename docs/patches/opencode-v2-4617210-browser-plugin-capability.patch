+      read: (id, signal) => Effect.runPromise(tunnel.read(id), { signal }),
+      write: (id, data, end, signal) => Effect.runPromise(tunnel.write(id, data, end), { signal }),
+      close: (id) => Effect.runPromise(tunnel.close(id)),
