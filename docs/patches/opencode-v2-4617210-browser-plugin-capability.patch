diff --git a/packages/core/src/plugin/browser.ts b/packages/core/src/plugin/browser.ts
new file mode 100644
index 0000000000..1c6921d87a
--- /dev/null
+++ b/packages/core/src/plugin/browser.ts
@@ -0,0 +1,59 @@
+export * as PluginBrowser from "./browser.js"
+
+import type { BrowserDomain, BrowserDriver } from "@opencode/plugin/effect/browser"
+import type { Permission } from "../permission.js"
+import { Effect } from "effect"
+
+/** Location-local broker. The registered driver never leaves the trusted host. */
+export function make(permission: Pick<Permission.Interface, "assert">) {
+  let driver: { readonly host: BrowserDriver } | undefined
+  return (pluginID: string, builtin = false): BrowserDomain => {
+    const authorize = (sessionID: Parameters<BrowserDomain["tabs"]>[0]["sessionID"], operation: string) =>
+      Effect.gen(function* () {
+        yield* permission.assert({ sessionID, action: "browser", resources: ["*"] })
+        yield* permission.assert({
+          sessionID,
+          action: "browser_plugin",
+          resources: [`${pluginID}:${operation}`],
+        })
+        // The plugin grant may have waited for a user while browser permission changed.
+        yield* permission.assert({ sessionID, action: "browser", resources: ["*"] })
+      })
+    return {
+      tabs: (input) =>
+        Effect.gen(function* () {
+          const owner = driver
+          if (!owner) return yield* Effect.fail(new Error("Desktop browser not connected"))
+          yield* authorize(input.sessionID, "tabs.list")
+          if (driver !== owner) return yield* Effect.fail(new Error("Browser host changed during authorization"))
+          return yield* owner.host.tabs(input)
+        }),
+      snapshot: (input) =>
+        Effect.gen(function* () {
+          const owner = driver
+          if (!owner) return yield* Effect.fail(new Error("Desktop browser not connected"))
+          yield* authorize(input.sessionID, "snapshot")
+          if (driver !== owner) return yield* Effect.fail(new Error("Browser host changed during authorization"))
+          return yield* owner.host.snapshot(input)
+        }),
+      register: (host) => {
+        const entry = { host }
+        return Effect.acquireRelease(
+          Effect.try({
+            try: () => {
+              if (!builtin || pluginID !== "opencode.browser")
+                throw new Error("Browser host registration is reserved for the built-in browser")
+              if (driver) throw new Error("Browser host already registered")
+              driver = entry
+            },
+            catch: (error) => (error instanceof Error ? error : new Error(String(error))),
+          }),
+          () =>
+            Effect.sync(() => {
+              if (driver === entry) driver = undefined
+            }),
+        )
+      },
+    }
+  }
+}
