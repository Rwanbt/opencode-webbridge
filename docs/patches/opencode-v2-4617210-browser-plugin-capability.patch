+  const resume = Deferred.makeUnsafe<void>()
+  const broker = PluginBrowser.make({
+    assert: () => Effect.gen(function* () {
+      calls++
+      if (calls === 2) {
+        yield* Deferred.succeed(awaiting, undefined)
