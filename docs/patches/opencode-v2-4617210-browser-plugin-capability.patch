+import { test, expect } from "bun:test"
+import { PluginBrowser } from "@opencode/core/plugin/browser"
+import { Tool as CoreTool } from "@opencode/core/tool"
+import { Agent } from "@opencode/schema/agent"
+import { BrowserTurn } from "@opencode/core/tool/browser-turn"
+import { Session } from "@opencode/schema/session"
+import { SessionMessage } from "@opencode/schema/session-message"
+import { Tool } from "@opencode/schema/tool"
+import { Location } from "@opencode/schema/location"
+import { AbsolutePath } from "@opencode/schema/schema"
+import { Workspace } from "@opencode/schema/workspace"
+import { Deferred, Effect, Exit, Scope } from "effect"
+import { testEffect } from "../lib/effect"
+import { PluginTestLayer } from "./fixture"
+
+const sessionID = Session.ID.make("ses_native_once")
+const turn = {
+  sessionID,
+  messageID: SessionMessage.ID.make("msg_native_once"),
+  id: Tool.CallID.make("call_native_once"),
+  agent: "build" as never,
+  progress: () => Effect.void,
+} satisfies Tool.Context
+const directory = AbsolutePath.make("/test-workspace")
+const location = Location.Ref.make({ directory, workspaceID: Workspace.ID.make("wrk_origin") })
+
+function fixture() {
+  let reads = 0
+  let binding = 0
+  const grants: string[] = []
+  const broker = PluginBrowser.make(
+    {
+      assert: (input) =>
+        Effect.sync(() => {
+          grants.push(`${input.action}:${input.resources.join(",")}`)
+        }),
+    },
+    {
+      location,
+      session: () => Effect.succeed(location),
+    },
+  )
+  const builtin = broker("opencode.browser", true)
+  const caller = broker("test-plugin")
+  const driver = {
+    tabs: () => Effect.succeed([]),
+    snapshot: () => Effect.succeed({ content: "old", truncated: false }),
+    bindSnapshot: () =>
+      Effect.sync(() => {
+        const initial = binding
+        return {
+          binding: { connectionID: "local-driver-1", tabGeneration: initial },
+          read: () =>
+            Effect.sync(() => {
+              if (binding !== initial) throw new Error("tab generation changed")
+              reads++
+              return { content: "local fixture", truncated: false }
+            }),
+        }
+      }),
+  }
+  return {
+    builtin,
+    caller,
+    driver,
+    grants,
+    get reads() {
+      return reads
+    },
+    invalidate: () => {
+      binding++
+    },
+  }
+}
+
+test("one-shot read refuses a forged context and permits exactly one native read per live turn", async () => {
+  const f = fixture()
+  await Effect.runPromise(
+    Effect.scoped(
+      Effect.gen(function* () {
+        yield* f.builtin.register(f.driver)
+        expect(Exit.isFailure(yield* Effect.exit(f.caller.snapshotOnce({ context: turn, tabID: "tab_local" })))).toBe(
+          true,
+        )
+        yield* BrowserTurn.withContext(
+          turn,
+          Effect.gen(function* () {
+            const result = yield* Effect.all(
+              [
+                Effect.exit(f.caller.snapshotOnce({ context: turn, tabID: "tab_local" })),
+                Effect.exit(f.caller.snapshotOnce({ context: turn, tabID: "tab_local" })),
+              ],
+              { concurrency: "unbounded" },
+            )
+            expect(result.filter(Exit.isSuccess)).toHaveLength(1)
+            expect(result.filter(Exit.isFailure)).toHaveLength(1)
+          }),
+        )
+        expect(Exit.isFailure(yield* Effect.exit(f.caller.snapshotOnce({ context: turn, tabID: "tab_local" })))).toBe(
+          true,
+        )
+      }),
+    ),
+  )
+  expect(f.reads).toBe(1)
+  expect(
+    f.grants.some((item) =>
+      item.includes(
+        `browser_plugin:test-plugin:snapshot.once:wrk_origin:${sessionID}:${turn.messageID}:${turn.id}:local-driver-1:tab_local:0`,
+      ),
+    ),
+  ).toBe(true)
+})
+
+test("cross-workspace fixture session cannot be granted even with a real tool turn", async () => {
+  const f = fixture()
+  const foreign = PluginBrowser.make(
+    { assert: () => Effect.void },
+    {
+      location,
+      session: () => Effect.succeed(Location.Ref.make({ directory, workspaceID: Workspace.ID.make("wrk_other") })),
+    },
+  )
+  const builtin = foreign("opencode.browser", true)
+  const caller = foreign("test-plugin")
+  await Effect.runPromise(
+    Effect.scoped(
+      Effect.gen(function* () {
+        yield* builtin.register(f.driver)
+        yield* BrowserTurn.withContext(
+          turn,
+          Effect.gen(function* () {
+            expect(Exit.isFailure(yield* Effect.exit(caller.snapshotOnce({ context: turn, tabID: "tab_local" })))).toBe(
+              true,
+            )
+          }),
+        )
+      }),
+    ),
+  )
+  expect(f.reads).toBe(0)
+})
+
+test("a mutated live turn cannot switch to a different session or message", async () => {
+  const f = fixture()
+  const modified = { ...turn }
+  await Effect.runPromise(
+    Effect.scoped(
+      Effect.gen(function* () {
+        yield* f.builtin.register(f.driver)
+        yield* BrowserTurn.withContext(
+          modified,
+          Effect.gen(function* () {
+            modified.sessionID = Session.ID.make("ses_forged")
+            expect(
+              Exit.isFailure(yield* Effect.exit(f.caller.snapshotOnce({ context: modified, tabID: "tab_local" }))),
+            ).toBe(true)
+            modified.sessionID = sessionID
+            modified.messageID = SessionMessage.ID.make("msg_forged")
+            expect(
+              Exit.isFailure(yield* Effect.exit(f.caller.snapshotOnce({ context: modified, tabID: "tab_local" }))),
+            ).toBe(true)
+          }),
+        )
+      }),
+    ),
+  )
+  expect(f.reads).toBe(0)
+})
+
+test("tab replacement while consent awaits invalidates the bound read", async () => {
+  const gate = Deferred.makeUnsafe<void>()
+  const resume = Deferred.makeUnsafe<void>()
+  const f = fixture()
+  const broker = PluginBrowser.make(
+    { assert: () => Deferred.succeed(gate, undefined).pipe(Effect.andThen(Deferred.await(resume))) },
+    { location, session: () => Effect.succeed(location) },
+  )
+  const owner = broker("opencode.browser", true)
+  const caller = broker("test-plugin")
+  const scope = await Effect.runPromise(Scope.make())
+  await Effect.runPromise(owner.register(f.driver).pipe(Effect.provideService(Scope.Scope, scope)))
+  const attempt = Effect.runPromiseExit(
+    BrowserTurn.withContext(turn, caller.snapshotOnce({ context: turn, tabID: "tab_local" })),
+  )
+  await Effect.runPromise(Deferred.await(gate))
+  f.invalidate()
+  await Effect.runPromise(Deferred.succeed(resume, undefined))
+  expect(Exit.isFailure(await attempt)).toBe(true)
+  expect(f.reads).toBe(0)
+  await Effect.runPromise(Scope.close(scope, Exit.void))
