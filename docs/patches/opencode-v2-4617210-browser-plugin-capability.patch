index 0000000000..bd554d6c8c
--- /dev/null
+++ b/packages/core/src/plugin/browser.ts
@@ -0,0 +1,119 @@
+export * as PluginBrowser from "./browser.js"
+
+import type { BrowserDomain, BrowserDriver } from "@opencode/plugin/effect/browser"
+import type { Permission } from "../permission.js"
+import type { BrowserLease } from "./browser-lease.js"
+import type { Session } from "@opencode/schema/session"
+import type { Location } from "@opencode/schema/location"
+import { BrowserTurn } from "../tool/browser-turn.js"
+import { Effect } from "effect"
+
+/** Location-local broker. The registered driver never leaves the trusted host. */
+export function make(
+  permission: Pick<Permission.Interface, "assert" | "browserRead" | "browserPolicy">,
+  scope?: {
+    readonly location: Location.Ref
+    readonly session: (id: Session.ID) => Effect.Effect<Location.Ref | undefined, Error>
+  },
+) {
+  let driver: { readonly host: BrowserDriver } | undefined
+  return (pluginID: string, builtin = false): BrowserDomain & { revoke: () => void } => {
+    let retired = false
+    // Generated inside trusted Core plugin activation, not accepted from caller arguments.
+    const pluginGeneration = crypto.randomUUID()
+    const authorize = (sessionID: Parameters<BrowserDomain["tabs"]>[0]["sessionID"], operation: string) =>
+      Effect.gen(function* () {
+        yield* permission.assert({ sessionID, action: "browser", resources: ["*"] })
+        yield* permission.assert({
+          sessionID,
+          action: "browser_plugin",
+          resources: [`${pluginID}:${operation}`],
+        })
+        // The plugin grant may have waited for a user while browser permission changed.
+        yield* permission.assert({ sessionID, action: "browser", resources: ["*"] })
+        // The browser recheck can also wait. Fail closed if the plugin grant changed meanwhile.
+        yield* permission.assert({
+          sessionID,
+          action: "browser_plugin",
+          resources: [`${pluginID}:${operation}`],
+        })
+      })
+    return {
+      revoke: () => {
+        retired = true
+      },
+      snapshotOnce: (input) =>
+        Effect.gen(function* () {
+          if (!scope || retired || !BrowserTurn.valid(input.context))
+            return yield* Effect.fail(new Error("No trusted active tool turn"))
+          // Never fall back to the older four async assert checks: they lack an atomic revision.
+          const authority = permission.browserRead
+          if (!authority) return yield* Effect.fail(new Error("Authoritative Core browser read lease unavailable"))
+          const owner = driver
+          if (!owner) return yield* Effect.fail(new Error("Desktop browser not connected"))
+          if (!owner.host.bindSnapshot) return yield* Effect.fail(new Error("Native transactional binding unavailable"))
+          const sessionID = input.context.sessionID
+          const sameLocation = (value: Location.Ref | undefined) =>
+            value?.directory === scope.location.directory && value.workspaceID === scope.location.workspaceID
+          if (!sameLocation(yield* scope.session(sessionID)))
+            return yield* Effect.fail(new Error("Session is not in this workspace"))
+          // The official driver pins the live attachment and exact tab generation BEFORE any prompt.
+          const bound = yield* owner.host.bindSnapshot({ sessionID, tabID: input.tabID })
+          const binding: BrowserLease.Binding = {
+            pluginID, pluginGeneration, agentID: input.context.agent,
+            sessionID, workspaceID: scope.location.workspaceID ?? "",
+            turnID: input.context.messageID, callID: input.context.id,
+            connectionID: bound.binding.connectionID, tabID: input.tabID,
+            tabGeneration: bound.binding.tabGeneration, action: "snapshot.once",
+          }
+          // Core Permission.Service owns the policy epoch and must authorize the exact binding.
+          const ticket = yield* authority.issue(binding)
+          if (!sameLocation(yield* scope.session(sessionID)))
+            return yield* Effect.fail(new Error("Session moved during authorization"))
+          return yield* Effect.suspend(() => {
+            if (driver !== owner || retired || !BrowserTurn.valid(input.context) ||
+                !authority.consume(ticket, binding) || !BrowserTurn.consume(input.context))
+              return Effect.fail(new Error("Browser grant expired or already consumed"))
+            // The host MUST check again after RPC retrieval, before Desktop commit.
+            return bound.read(() => driver === owner && !retired && authority.current(ticket, binding))
+          })
+        }),
+      tabs: (input) =>
+        Effect.gen(function* () {
+          if (retired) return yield* Effect.fail(new Error("Plugin generation unloaded"))
+          const owner = driver
+          if (!owner) return yield* Effect.fail(new Error("Desktop browser not connected"))
+          const revision = permission.browserPolicy?.()
+          if (revision === undefined)
+            return yield* Effect.fail(new Error("Core browser policy revision unavailable"))
+          yield* authorize(input.sessionID, "tabs.list")
+          if (driver !== owner || retired || permission.browserPolicy?.() !== revision)
+            return yield* Effect.fail(new Error("Browser policy or host changed during authorization"))
+          const result = yield* owner.host.tabs(input)
+          if (driver !== owner || retired || permission.browserPolicy?.() !== revision)
+            return yield* Effect.fail(new Error("Browser policy or host changed during tab inventory"))
+          return result
+        }),
+      // Legacy ctx.browser.snapshot has no trusted tool turn or Core epoch.
+      snapshot: () => Effect.fail(new Error("Legacy plugin snapshot lacks Core authority; use snapshotOnce")),
+      register: (host) => {
+        const entry = { host }
+        return Effect.acquireRelease(
+          Effect.try({
+            try: () => {
+              if (!builtin || pluginID !== "opencode.browser")
+                throw new Error("Browser host registration is reserved for the built-in browser")
+              if (driver) throw new Error("Browser host already registered")
+              driver = entry
+            },
+            catch: (error) => (error instanceof Error ? error : new Error(String(error))),
+          }),
+          () =>
+            Effect.sync(() => {
+              if (driver === entry) driver = undefined
+            }),
+        )
+      },
+    }
+  }
+}
