+    expect(real.generation).toBe(1) // Fake state must not replace the tab generation.
+    expect(yield* commands["read.commit"]({ ...base, requestID, ticket: real.readCommit }, caller)).toBe(true)
+    yield* Fiber.interrupt(reading)
+  }))
