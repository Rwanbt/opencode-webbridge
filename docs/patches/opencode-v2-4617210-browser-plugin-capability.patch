+function fixture(withAuthority = true) {
+  let reads = 0
+  let binding = 0
+  const grants: string[] = []
+  const broker = PluginBrowser.make(
+    {
+      assert: (input) =>
+        Effect.sync(() => {
+          grants.push(`${input.action}:${input.resources.join(",")}`)
+        }),
+      browserPolicy: () => 0,
+      ...(withAuthority ? { browserRead: BrowserLease.make({
+        authorize: (input) => Effect.sync(() => {
+          grants.push(`browserRead:${input.pluginID}:${input.pluginGeneration}:${input.agentID}:${input.action}:${input.sessionID}:${input.turnID}:${input.callID}:${input.connectionID}:${input.tabID}:${input.tabGeneration}`)
+        }),
+        live: () => true,
+      }) } : {}),
+    },
+    {
+      location,
+      session: () => Effect.succeed(location),
+    },
+  )
+  const builtin = broker("opencode.browser", true)
+  const caller = broker("test-plugin")
+  const driver = {
+    tabs: () => Effect.succeed([]),
+    snapshot: () => Effect.succeed({ content: "old", truncated: false }),
+    bindSnapshot: () =>
+      Effect.sync(() => {
+        const initial = binding
+        return {
+          binding: { connectionID: "local-driver-1", tabGeneration: initial },
+          read: () =>
+            Effect.sync(() => {
+              if (binding !== initial) throw new Error("tab generation changed")
+              reads++
+              return { content: "local fixture", truncated: false }
+            }),
+        }
+      }),
+  }
+  return {
+    builtin,
+    caller,
+    driver,
+    grants,
+    get reads() {
+      return reads
+    },
+    invalidate: () => {
+      binding++
+    },
+  }
+}
+
