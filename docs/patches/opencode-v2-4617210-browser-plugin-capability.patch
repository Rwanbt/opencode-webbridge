+      snapshot: () => Effect.fail(new Error("not used")),
+    } as never)
+    const pending = yield* consumer.tabs({ sessionID }).pipe(Effect.exit, Effect.forkScoped)
+    yield* Deferred.await(awaiting)
+    policyEpoch++ // Saved-rule mutation while permission.assert is waiting.
+    yield* Deferred.succeed(resume, undefined)
+    expect(Exit.isFailure(yield* Fiber.join(pending))).toBe(true)
+  })))
+  expect(disclosed).toBe(0)
+})
