+    })
+    const credentials = `Basic ${Buffer.from(`${proxy.credentials.username}:${proxy.credentials.password}`).toString("base64")}`
+    const result = await new Promise<{ status: number; body: string; headers: import("node:http").IncomingHttpHeaders }>((resolve, reject) => {
+      const req = request({
+        hostname: proxy!.host, port: proxy!.port, method: "GET",
+        path: "http://example.test/a?b=c",
+        headers: { "Proxy-Authorization": credentials },
+      }, (res) => {
+        const parts: Buffer[] = []
+        res.on("data", (chunk: Buffer) => parts.push(chunk))
+        res.on("end", () => resolve({ status: res.statusCode ?? 0, body: Buffer.concat(parts).toString(), headers: res.headers }))
+      })
+      req.once("error", reject)
+      req.end()
