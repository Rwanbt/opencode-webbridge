diff --git a/packages/core/src/plugin/browser-lease.ts b/packages/core/src/plugin/browser-lease.ts
new file mode 100644
index 0000000000..eb2fa054e8
--- /dev/null
+++ b/packages/core/src/plugin/browser-lease.ts
@@ -0,0 +1,151 @@
+export * as BrowserLease from "./browser-lease.js"
+
+import { Effect, Exit } from "effect"
+
+/** The caller/plugin does not construct the actual Desktop binding. */
+export type Binding = Readonly<{
+  pluginID: string
+  pluginGeneration: string
+  agentID: string
+  sessionID: string
+  workspaceID: string
+  turnID: string
+  callID: string
+  connectionID: string
+  tabID: string
+  tabGeneration: number
+  action: string
+}>
+
+export type Ticket = Readonly<{ id: string }>
+
+const fields = [
+  "pluginID",
+  "pluginGeneration",
+  "agentID",
+  "sessionID",
+  "workspaceID",
+  "turnID",
+  "callID",
+  "connectionID",
+  "tabID",
+  "tabGeneration",
+  "action",
+] as const
+
+/** Core-local reference contract; not a Desktop-authorized capability. */
+export function make(input: {
+  readonly authorize: (binding: Binding) => Effect.Effect<void, Error>
+  /** Must resolve to trusted current host/session/turn/driver state, not plugin inputs. */
+  readonly live: (binding: Binding) => boolean
+  readonly clock?: () => number
+  readonly ttlMs?: number
+  readonly authorizeTimeoutMs?: number
+}) {
+  const pending = new Map<string, { binding: Binding; epoch: number; expires: number }>()
+  // Keep only consumed leases for the host-side revalidation window; not a durable ledger.
+  const consumed = new Map<string, { binding: Binding; epoch: number; expires: number }>()
+  const reserved = new Set<string>()
+  const clock = input.clock ?? (() => performance.now())
+  const ttlMs = input.ttlMs ?? 5000
+  if (!Number.isFinite(ttlMs) || ttlMs <= 0 || ttlMs > 30_000) throw new Error("Invalid Browser lease TTL")
+  let lastTick = Number.NEGATIVE_INFINITY
+  const now = () => {
+    const tick = clock()
+    if (!Number.isFinite(tick) || tick < lastTick) return Number.NaN
+    lastTick = tick
+    return tick
+  }
+  let epoch = 0
+  let retired = false
+  const valid = (binding: Binding) =>
+    binding !== null &&
+    typeof binding === "object" &&
+    Object.keys(binding).length === fields.length &&
+    fields.every((field) => {
+      const value = binding[field]
+      return field === "tabGeneration"
+        ? typeof value === "number" && Number.isSafeInteger(value) && value >= 0
+        : typeof value === "string" && value.length > 0 && value.length <= 1024
+    })
+  const same = (a: Binding, b: Binding) => fields.every((field) => a[field] === b[field])
+  const keyOf = (binding: Binding) => JSON.stringify(fields.map((field) => binding[field]))
+  const revoke = () => {
+    epoch++
+    pending.clear()
+    // An epoch cannot erase a spent turn/call binding: a write may already have committed.
+  }
+  return {
+    issue: (binding: Binding) =>
+      Effect.gen(function* () {
+        if (!valid(binding)) return yield* Effect.fail(new Error("Browser lease binding invalid or unavailable"))
+        const pinned = Object.freeze({ ...binding })
+        if (!valid(pinned) || retired || !input.live(pinned))
+          return yield* Effect.fail(new Error("Browser lease binding invalid or unavailable"))
+        const observed = epoch
+        const key = keyOf(pinned)
+        yield* Effect.sync(() => {
+          if (reserved.size >= 1024) throw new Error("Browser lease spent-call ledger exhausted")
+          if (reserved.has(key)) throw new Error("Browser lease binding already reserved or spent")
+          reserved.add(key)
+        })
+        // This may wait for the user. Any intervening revoke poisons the issue.
+        yield* input.authorize(pinned).pipe(
+          Effect.timeout(input.authorizeTimeoutMs ?? 30_000),
+          Effect.onExit((exit) =>
+            Exit.isFailure(exit)
+              ? Effect.sync(() => {
+                  if (epoch === observed) reserved.delete(key)
+                })
+              : Effect.void,
+          ),
+        )
+        return yield* Effect.sync(() => {
+          if (!input.live(pinned) || retired || epoch !== observed || !valid(binding) || !same(binding, pinned))
+            throw new Error("Browser lease revoked during authorization")
+          const time = now()
+          if (!Number.isFinite(time)) throw new Error("Browser lease clock unavailable or rolled back")
+          const ticket = Object.freeze({ id: crypto.randomUUID() })
+          pending.set(ticket.id, { binding: pinned, epoch, expires: time + ttlMs })
+          return ticket
+        })
+      }),
+    /** Synchronous compare-and-consume; never leave an await between this and a local effect. */
+    consume: (ticket: Ticket, actual: Binding) => {
+      const item = pending.get(ticket.id)
+      if (!item) return false
+      pending.delete(ticket.id) // Fail closed even on a mismatched or expired attempt.
+      const accepted = (
+        !retired &&
+        now() < item.expires &&
+        valid(actual) &&
+        same(item.binding, actual) &&
+        input.live(actual) &&
+        item.epoch === epoch
+      )
+      if (accepted) consumed.set(ticket.id, item)
+      return accepted
+    },
+    /** Revalidate a consumed read's authoritative epoch at host commit and before accepting its result. */
+    current: (ticket: Ticket, actual: Binding) => {
+      const item = consumed.get(ticket.id)
+      if (!item) return false
+      const permitted = !retired && now() < item.expires && valid(actual) &&
+        same(item.binding, actual) && input.live(actual) && item.epoch === epoch
+      if (!permitted) consumed.delete(ticket.id)
+      return permitted
+    },
+    revoke,
+    retire: () => {
+      retired = true
+      revoke()
+    },
+    get outstanding() {
+      return pending.size
+    },
+    /** Core-only policy generation, also advances for session and user rejection events. */
+    get revision() {
+      return epoch
+    },
+  }
+}
