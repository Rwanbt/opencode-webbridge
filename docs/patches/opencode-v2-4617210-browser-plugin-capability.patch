+import { expect, test } from "bun:test"
+import { Cause, Deferred, Effect, Exit, Fiber, Stream } from "effect"
+import { AbsolutePath } from "@opencode/schema/schema"
+import { Location } from "@opencode/schema/location"
+import { Project } from "@opencode/schema/project"
+import { Session } from "@opencode/schema/session"
+import { Workspace } from "@opencode/schema/workspace"
+import { BrowserConnection } from "../src/connection"
+
+const sessionID = Session.ID.make("ses_first_unverified")
+const directory = AbsolutePath.make("/first-attach-authority")
+const location = new Location.Info({ directory, workspaceID: Workspace.ID.make("wrk_first_attach"),
+  project: { id: Project.ID.global, directory, canonical: directory } })
+const claim = { sessionID, connectionID: "self-asserted-desktop", attachmentProof: crypto.randomUUID(), version: 6 }
+const caller = { error: (_kind: string, message: string) => new Error(message) }
+
+test("a first RPC client cannot self-attest Desktop and inject a session-wide browser allow", async () => {
+  let updates = 0
+  let announcements = 0
+  let handlers: Record<string, (input: any, call: any) => any> = {}
+  const ctx = {
+    location, agent: { transform: () => Effect.void }, event: { subscribe: () => Stream.empty },
+    session: { get: () => Effect.succeed({ location, permissions: [] }),
+      update: () => Effect.sync(() => { updates++ }) },
+    rpc: { register: (_: unknown, commands: typeof handlers) => {
+      handlers = commands
+      return Effect.succeed({ events: { emit: () => Effect.sync(() => { announcements++ }) } })
+    } },
+  } as unknown as Parameters<typeof BrowserConnection.make>[0]
+  await Effect.runPromise(Effect.scoped(Effect.gen(function* () {
+    const scope = yield* BrowserConnection.make(ctx)
+    const first = yield* Effect.exit(handlers.attach({ ...claim, claimedElectron: true }, caller)
+      .pipe(Effect.timeout("250 millis")))
+    // Previous native code auto-inserted browser:* allow for this unverified first caller.
+    expect(updates).toBe(0)
+    expect(announcements).toBe(0)
+    expect(Exit.isFailure(first)).toBe(true)
+    if (Exit.isFailure(first)) expect(Cause.pretty(first.cause)).toContain("verified Desktop")
+    expect(Exit.isFailure(yield* Effect.exit(scope.tabs(sessionID)))).toBe(true)
+    const tunnel = yield* Effect.exit(handlers["tunnel.open"]({
+      ...claim, target: { host: "127.0.0.1", port: 443 },
+    }, caller))
+    expect(Exit.isFailure(tunnel)).toBe(true)
+    if (Exit.isFailure(tunnel)) expect(Cause.pretty(tunnel.cause)).toContain("Browser attachment is unavailable")
+  })) as unknown as Effect.Effect<void, unknown, never>)
+})
+
+test("Core-supplied trusted transport authority preserves the tabs metadata mirror", async () => {
+  let handlers: Record<string, (input: any, call: any) => any> = {}
+  const attached = Deferred.makeUnsafe<void>()
+  const ctx = {
+    location, agent: { transform: () => Effect.void }, event: { subscribe: () => Stream.empty },
+    session: { get: () => Effect.succeed({ location, permissions: [] }), update: () => Effect.void },
+    rpc: { register: (_: unknown, commands: typeof handlers) => {
+      handlers = commands
+      return Effect.succeed({ events: { emit: () => Deferred.succeed(attached, undefined) } })
+    } },
+  } as unknown as Parameters<typeof BrowserConnection.make>[0]
+  await Effect.runPromise(Effect.scoped(Effect.gen(function* () {
+    const scope = yield* BrowserConnection.make(ctx, { verify: () => Effect.succeed(true) })
+    const live = yield* handlers.attach(claim, caller).pipe(Effect.forkScoped({ startImmediately: true }))
+    yield* Deferred.await(attached)
+    yield* handlers.state({ ...claim, state: { tabs: [], focusedTabID: null } }, caller)
+    expect(yield* scope.tabs(sessionID)).toEqual({ tabs: [], focusedTabID: null })
+    yield* Fiber.interrupt(live)
+  })) as unknown as Effect.Effect<void, unknown, never>)
+})
