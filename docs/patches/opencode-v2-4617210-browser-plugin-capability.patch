+import { Session } from "@opencode/schema/session"
+import { Workspace } from "@opencode/schema/workspace"
+import { BrowserConnection } from "../src/connection"
+
+const sessionID = Session.ID.make("ses_attach_owner")
+const directory = AbsolutePath.make("/attach-owner")
+const location = new Location.Info({ directory, workspaceID: Workspace.ID.make("wrk_attach_owner"),
+  project: { id: Project.ID.global, directory, canonical: directory } })
+const caller = { error: (_kind: string, message: string) => new Error(message) }
+const a = { sessionID, connectionID: "desktop-A", attachmentProof: "00000000-0000-4000-8000-000000000001" }
+const b = { sessionID, connectionID: "client-B", attachmentProof: "00000000-0000-4000-8000-000000000002" }
+const empty = { tabs: [], focusedTabID: null }
+const allow = { action: "browser", resource: "*", effect: "allow" } as const
+
+test("second RPC caller cannot mint a replacement attachment or modify an active Desktop grant", async () => {
+  const announced = Deferred.makeUnsafe<void>()
+  let permissions: { action: string; resource: string; effect: "allow" | "deny" | "ask" }[] = []
+  let handlers: Record<string, (input: any, caller: any) => any> = {}
+  let updates = 0
+  const ctx = {
+    location, agent: { transform: () => Effect.void }, event: { subscribe: () => Stream.empty },
+    session: {
+      get: () => Effect.succeed({ location, permissions }),
+      update: (input: { permissions: typeof permissions }) => Effect.sync(() => {
+        permissions = input.permissions
+        updates++
+      }),
+    },
+    rpc: { register: (_schema: unknown, commands: typeof handlers) => {
+      handlers = commands
+      return Effect.succeed({ events: { emit: (_: string, event: any) =>
+        event.type === "attached" ? Deferred.succeed(announced, undefined) : Effect.void } })
+    } },
+  } as unknown as Parameters<typeof BrowserConnection.make>[0]
+  await Effect.runPromise(Effect.scoped(Effect.gen(function* () {
+    yield* BrowserConnection.make(ctx, { verify: () => Effect.succeed(true) })
+    const original = yield* handlers.attach({ ...a, version: 6 }, caller)
+      .pipe(Effect.forkScoped({ startImmediately: true }))
+    yield* Deferred.await(announced)
+    expect(permissions.filter((rule) => rule.action === "browser" && rule.effect === "allow")).toHaveLength(1)
+    const attempt = yield* Effect.exit(handlers.attach({ ...b, version: 6 }, caller).pipe(Effect.timeout("1 second")))
+    expect(Exit.isFailure(attempt)).toBe(true)
+    if (Exit.isFailure(attempt)) expect(Cause.pretty(attempt.cause)).toContain("already attached")
+    expect(Exit.isFailure(yield* Effect.exit(Fiber.await(original).pipe(Effect.timeout("50 millis"))))).toBe(true)
+    expect(updates).toBe(1)
+    expect(Exit.isSuccess(yield* Effect.exit(handlers.state({ ...a, state: empty }, caller)))).toBe(true)
+    expect(Exit.isFailure(yield* Effect.exit(handlers.state({ ...b, state: empty }, caller)))).toBe(true)
+    const tunnel = yield* Effect.exit(handlers["tunnel.open"]({ ...b, target: { host: "127.0.0.1", port: 1 } }, caller))
+    expect(Exit.isFailure(tunnel)).toBe(true)
+    if (Exit.isFailure(tunnel)) expect(Cause.pretty(tunnel.cause)).toContain("Browser attachment is unavailable")
+    yield* Fiber.interrupt(original)
+  })) as Effect.Effect<void, unknown, never>)
+  expect(permissions).toEqual([])
+})
+
+test("pending session grant cannot be overtaken", async () => {
+  const grantStarted = Deferred.makeUnsafe<void>()
+  const resume = Deferred.makeUnsafe<void>()
+  const announced = Deferred.makeUnsafe<void>()
+  let permissions: (typeof allow)[] = []
+  let handlers: Record<string, (input: any, caller: any) => any> = {}
+  let updates = 0
+  const ctx = {
+    location, agent: { transform: () => Effect.void }, event: { subscribe: () => Stream.empty },
+    session: {
+      get: () => Effect.succeed({ location, permissions }),
+      update: (input: { permissions: typeof permissions }) =>
+        Deferred.succeed(grantStarted, undefined).pipe(Effect.andThen(Deferred.await(resume)),
+          Effect.andThen(Effect.sync(() => { permissions = input.permissions; updates++ }))),
+    },
+    rpc: { register: (_schema: unknown, commands: typeof handlers) => {
+      handlers = commands
+      return Effect.succeed({ events: { emit: () => Deferred.succeed(announced, undefined) } })
+    } },
+  } as unknown as Parameters<typeof BrowserConnection.make>[0]
+  await Effect.runPromise(Effect.scoped(Effect.gen(function* () {
+    yield* BrowserConnection.make(ctx, { verify: () => Effect.succeed(true) })
+    const original = yield* handlers.attach({ ...a, version: 6 }, caller)
+      .pipe(Effect.forkScoped({ startImmediately: true }))
+    yield* Deferred.await(grantStarted)
+    const attempt = yield* Effect.exit(handlers.attach({ ...b, version: 6 }, caller).pipe(Effect.timeout("1 second")))
+    expect(Exit.isFailure(attempt)).toBe(true)
+    if (Exit.isFailure(attempt)) expect(Cause.pretty(attempt.cause)).toContain("already attached")
+    expect(Exit.isFailure(yield* Effect.exit(handlers.state({ ...b, state: empty }, caller)))).toBe(true)
+    yield* Deferred.succeed(resume, undefined)
+    yield* Deferred.await(announced)
+    expect(Exit.isSuccess(yield* Effect.exit(handlers.state({ ...a, state: empty }, caller)))).toBe(true)
+    yield* Fiber.interrupt(original)
+  })) as Effect.Effect<void, unknown, never>)
+  expect(permissions).toEqual([])
+  expect(updates).toBe(2)
+})
+
+test("existing explicit browser allow is never revoked by a temporary attachment", async () => {
+  let permissions = [allow]
+  let updates = 0
+  let handlers: Record<string, (input: any, caller: any) => any> = {}
+  const announced = Deferred.makeUnsafe<void>()
+  const ctx = {
+    location, agent: { transform: () => Effect.void }, event: { subscribe: () => Stream.empty },
+    session: {
+      get: () => Effect.succeed({ location, permissions }),
+      update: () => Effect.sync(() => { updates++ }),
+    },
+    rpc: { register: (_schema: unknown, commands: typeof handlers) => {
+      handlers = commands
+      return Effect.succeed({ events: { emit: () => Deferred.succeed(announced, undefined) } })
+    } },
+  } as unknown as Parameters<typeof BrowserConnection.make>[0]
+  await Effect.runPromise(Effect.scoped(Effect.gen(function* () {
+    yield* BrowserConnection.make(ctx, { verify: () => Effect.succeed(true) })
+    const original = yield* handlers.attach({ ...a, version: 6 }, caller)
+      .pipe(Effect.forkScoped({ startImmediately: true }))
+    yield* Deferred.await(announced)
+    yield* Fiber.interrupt(original)
+  })) as Effect.Effect<void, unknown, never>)
+  expect(permissions).toEqual([allow])
+  expect(updates).toBe(0)
+})
+
+test("new attach waits for the previous permission grant to finish releasing", async () => {
+  const firstReady = Deferred.makeUnsafe<void>()
+  const releaseStarted = Deferred.makeUnsafe<void>()
+  const allowRelease = Deferred.makeUnsafe<void>()
+  let permissions: (typeof allow)[] = []
+  let updateCount = 0
+  let handlers: Record<string, (input: any, caller: any) => any> = {}
+  const ctx = {
+    location, agent: { transform: () => Effect.void }, event: { subscribe: () => Stream.empty },
+    session: {
+      get: () => Effect.succeed({ location, permissions }),
+      update: (input: { permissions: typeof permissions }) => Effect.gen(function* () {
+        updateCount++
+        if (updateCount === 2) {
+          yield* Deferred.succeed(releaseStarted, undefined)
+          yield* Deferred.await(allowRelease)
+        }
+        permissions = input.permissions
+      }),
+    },
+    rpc: { register: (_schema: unknown, commands: typeof handlers) => {
+      handlers = commands
+      return Effect.succeed({ events: { emit: () => Deferred.succeed(firstReady, undefined) } })
+    } },
+  } as unknown as Parameters<typeof BrowserConnection.make>[0]
+  await Effect.runPromise(Effect.scoped(Effect.gen(function* () {
+    yield* BrowserConnection.make(ctx, { verify: () => Effect.succeed(true) })
+    const original = yield* handlers.attach({ ...a, version: 6 }, caller)
+      .pipe(Effect.forkScoped({ startImmediately: true }))
+    yield* Deferred.await(firstReady)
+    const stopping = yield* Fiber.interrupt(original).pipe(Effect.forkScoped({ startImmediately: true }))
+    yield* Deferred.await(releaseStarted)
+    const denied = yield* Effect.exit(handlers.attach({ ...b, version: 6 }, caller).pipe(Effect.timeout("1 second")))
+    expect(Exit.isFailure(denied)).toBe(true)
+    if (Exit.isFailure(denied)) expect(Cause.pretty(denied.cause)).toContain("already attached")
+    yield* Deferred.succeed(allowRelease, undefined)
+    yield* Fiber.join(stopping)
+    expect(permissions).toEqual([])
+    const next = yield* handlers.attach({ ...b, version: 6 }, caller)
+      .pipe(Effect.forkScoped({ startImmediately: true }))
+    expect(Exit.isSuccess(yield* Effect.exit(handlers.state({ ...b, state: empty }, caller)))).toBe(true)
+    yield* Fiber.interrupt(next)
+  })) as Effect.Effect<void, unknown, never>)
+  expect(permissions).toEqual([])
+  expect(updateCount).toBe(4)
+})
