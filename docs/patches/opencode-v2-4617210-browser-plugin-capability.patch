+test("tab replacement while consent awaits invalidates the bound read", async () => {
+  const gate = Deferred.makeUnsafe<void>()
+  const resume = Deferred.makeUnsafe<void>()
+  const f = fixture()
+  const broker = PluginBrowser.make(
+    { assert: () => Effect.void,
+      browserRead: BrowserLease.make({ authorize: () =>
+        Deferred.succeed(gate, undefined).pipe(Effect.andThen(Deferred.await(resume))), live: () => true }) },
+    { location, session: () => Effect.succeed(location) },
