@@ -0,0 +1,54 @@
+export * as BrowserTurn from "./browser-turn.js"
+
+import type { Tool } from "@opencode/schema/tool"
+import { Effect } from "effect"
+
+// Proofs are the *identity* of Tool.Context objects created by the Core tool executor,
+// not caller-supplied session/message strings. No proof is serialized to plugins or RPC.
+const active = new WeakMap<
+  Tool.Context,
+  {
+    used: boolean
+    sessionID: Tool.Context["sessionID"]
+    messageID: Tool.Context["messageID"]
+    id: Tool.Context["id"]
+  }
+>()
+
+export function withContext<A, E, R>(context: Tool.Context, task: Effect.Effect<A, E, R>) {
+  return Effect.acquireUseRelease(
+    Effect.sync(() => {
+      if (active.has(context)) throw new Error("Tool context is already active")
+      active.set(context, {
+        used: false,
+        sessionID: context.sessionID,
+        messageID: context.messageID,
+        id: context.id,
+      })
+    }),
+    () => task,
+    () =>
+      Effect.sync(() => {
+        active.delete(context)
+      }),
+  )
+}
+
+/** Synchronous one-shot consume. Do not await between verification and consumption. */
+export function consume(context: Tool.Context) {
+  const claim = active.get(context)
+  if (!claim || claim.used || !valid(context)) return false
+  claim.used = true
+  return true
+}
+
+export function valid(context: Tool.Context) {
+  const claim = active.get(context)
+  return (
+    !!claim &&
+    !claim.used &&
+    claim.sessionID === context.sessionID &&
+    claim.messageID === context.messageID &&
+    claim.id === context.id
+  )
+}
