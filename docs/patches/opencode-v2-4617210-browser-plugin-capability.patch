+test("even the first V6 self-attacher cannot tunnel to a server-side loopback TCP service", async () => {
+  const sockets = new Set<import("node:net").Socket>()
+  const server = createServer((socket) => {
+    sockets.add(socket)
+    socket.once("close", () => sockets.delete(socket))
+  })
+  await once(server.listen(0, "127.0.0.1"), "listening")
+  const address = server.address()
+  if (!address || typeof address === "string") throw new Error("Missing listener")
+  const location = new Location.Info({ directory: AbsolutePath.make("/fixture"),
+    workspaceID: Workspace.ID.make("wrk_fixture"),
+    project: { id: Project.ID.global, directory: AbsolutePath.make("/fixture"),
+      canonical: AbsolutePath.make("/fixture") } })
+  const sessionID = Session.ID.make("ses_first_claim")
+  const base = { sessionID, connectionID: "self-minted", attachmentProof: crypto.randomUUID() }
+  const announced = Deferred.makeUnsafe<void>()
+  let handlers: Record<string, (input: any, call: any) => any> = {}
+  let session = { location, permissions: [] as { action: string; resource: string; effect: "allow" | "deny" | "ask" }[] }
+  const ctx = {
+    location,
+    agent: { transform: () => Effect.void },
+    event: { subscribe: () => Stream.empty },
+    session: { get: () => Effect.succeed(session),
+      update: (input: { permissions: typeof session.permissions }) => Effect.sync(() => {
+        session = { ...session, permissions: input.permissions }
+      }) },
+    rpc: { register: (_definition: unknown, calls: typeof handlers) => {
+      handlers = calls
+      return Effect.succeed({ events: { emit: () => Deferred.succeed(announced, undefined) } })
+    } },
+  } as unknown as Parameters<typeof BrowserConnection.make>[0]
+  try {
+    await Effect.runPromise(Effect.scoped(Effect.gen(function* () {
+      yield* BrowserConnection.make(ctx, { verify: () => Effect.succeed(true) })
+      const call = { error: (_kind: string, message: string) => new Error(message) }
+      const attached = yield* handlers.attach({ ...base, version: 6 }, call)
+        .pipe(Effect.forkScoped({ startImmediately: true }))
+      yield* Deferred.await(announced)
+      // This caller invented its proof; BrowserConnection cannot certify Electron.
+      expect(session.permissions.some((x) => x.action === "browser" && x.effect === "allow")).toBe(true)
+      const denied = yield* Effect.exit(handlers["tunnel.open"]({
+        ...base, target: { host: "127.0.0.1", port: address.port },
+      }, call))
+      expect(Exit.isFailure(denied)).toBe(true)
+      if (Exit.isFailure(denied)) expect(Cause.pretty(denied.cause)).toContain("private or untrusted")
+      expect(sockets.size).toBe(0)
+      yield* Fiber.interrupt(attached)
+    })) as Effect.Effect<void, unknown, never>)
+  } finally {
+    sockets.forEach((socket) => socket.destroy())
+    await new Promise<void>((resolve) => server.close(() => resolve()))
+  }
+})
